---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import portrait from '../../images/Profile Pic-1.jpeg';
---

<Layout>
  <div class='page'>
    <main id='main'>
      <div class='portrait'>
        <Image src={portrait} alt='Radhi Arrazzaaq' widths={[240, 480, 640]} sizes='(max-height: 600px) 110px, (max-width: 600px) 160px, 220px' width={640} format='webp' loading='eager' fetchpriority='high' />
      </div>
      <p class='eyebrow'>Hi! My name is</p>
      <h1>Radhi <em>Arrazzaaq</em></h1>
      <p class='description'>I do Paid Ads Marketing<br /><span class='hint'>(Click on WhatsApp to ask me)</span></p>
      <nav class='links' aria-label='Connect with Radhi'>
        <a id='enquiry-open' class='button primary' href='https://wa.me/6282273612856' target='_blank' rel='noopener noreferrer' aria-haspopup='dialog'>Say hello on WhatsApp <span aria-hidden='true'>&#8599;</span></a>
        <a class='button secondary' href='https://www.instagram.com/radhiarrazzaaq/' target='_blank' rel='noopener noreferrer'>Instagram <span class='handle'>@radhiarrazzaaq</span><span aria-hidden='true'>&#8599;</span></a>
      </nav>
      <a class='scroll-cue' href='#case-title'>Explore the work <span aria-hidden='true'>↓</span></a>
    </main>
    <section class='case-study' aria-labelledby='case-title'>
      <div class='case-heading' data-reveal>
        <p class='eyebrow'>SELECTED CASE STUDY <span aria-hidden='true'>&middot;</span> OCT–DEC 2025</p>
        <h2 id='case-title'>SaaS for <em>Doctors</em></h2>
        <p class='case-intro'>A lead generation and qualification system for a healthcare SaaS product.</p>
      </div>

      <div class='case-grid'>
        <section class='case-story' aria-labelledby='case-challenge' data-reveal>
          <h3 id='case-challenge'>The challenge</h3>
          <p>Generate qualified leads while keeping cost per qualified lead near Rp80,000. Lead volume alone was not enough. Sales needed prospects with clear intent.</p>
          <h3>The approach</h3>
          <p>I connected Meta Instant Forms, Click to WhatsApp, and Google Search Ads to a qualification flow that filtered leads before the sales handoff.</p>
          <ul class='channels' aria-label='Campaign channels'>
            <li>Meta Ads</li>
            <li>Google Search Ads</li>
            <li>Click to WhatsApp</li>
          </ul>
        </section>

        <section class='results' aria-labelledby='results-title' data-reveal>
          <p id='results-title' class='results-label'>Campaign results</p>
          <dl>
            <div>
              <dt>320</dt>
              <dd>qualified leads</dd>
            </div>
            <div>
              <dt>Rp35.6M</dt>
              <dd>total ad spend</dd>
            </div>
            <div>
              <dt>3 months</dt>
              <dd>campaign period</dd>
            </div>
          </dl>
          <p class='results-note'>The result: fewer spam and invalid leads, faster intent validation, and a more focused sales handoff.</p>
        </section>
      </div>

      <section class='funnel' aria-labelledby='funnel-title' data-reveal>
        <div>
          <p class='eyebrow'>MY ROLE</p>
          <h3 id='funnel-title'>From campaign setup to validated handoff</h3>
        </div>
        <ol>
          <li><span>01</span> Build campaign structure</li>
          <li><span>02</span> Qualify leads through forms and WhatsApp</li>
          <li><span>03</span> Monitor CPL and lead quality</li>
          <li><span>04</span> Coordinate validated leads with sales</li>
        </ol>
      </section>
    </section>
    <footer>&copy; {new Date().getFullYear()} Radhi Arrazzaaq <span aria-hidden='true'>&middot;</span> A space to connect.</footer>
  </div>
  <dialog id='enquiry' aria-labelledby='enquiry-title'>
    <div class='dialog-heading'><p class='eyebrow'>LET'S TALK</p><button id='enquiry-close' class='close' aria-label='Close enquiry' type='button'>&times;</button></div>
    <h2 id='enquiry-title' tabindex='-1'>How can I help?</h2>
    <section data-step='start' class='choices'>
      <button class='button primary' id='choose-paid' type='button'>I want to do Paid Ads</button>
      <button class='button secondary' data-other type='button'>Others — tell me what you need</button>
    </section>
    <section data-step='platform' class='choices' hidden>
      <button class='button primary' data-platform='Google Ads' type='button'>Google Ads</button>
      <button class='button secondary' data-platform='Meta Ads' type='button'>Meta Ads</button>
      <button class='button secondary' data-other type='button'>Others — customize my request</button>
    </section>
    <form data-step='custom' id='custom-form' hidden>
      <label for='custom-request'>What would you like to discuss?</label>
      <textarea id='custom-request' rows='4' maxlength='1000' required placeholder='Tell me about your business or what you need help with...'></textarea>
      <button class='button primary' type='submit'>Review message</button>
    </form>
    <section data-step='confirm' hidden>
      <p class='dialog-copy'>Here's your message to Radhi:</p>
      <p id='message-preview'></p>
      <a id='whatsapp-send' class='button primary' target='_blank' rel='noopener noreferrer'>Continue to WhatsApp &#8599;</a>
      <p class='dialog-note'>WhatsApp will open with this message ready. You can edit it before sending.</p>
    </section>
    <button id='enquiry-back' class='back' type='button' hidden>&larr; Back</button>
  </dialog>
</Layout>

<script>
  const dialog = document.querySelector<HTMLDialogElement>('#enquiry')!;
  const title = document.querySelector<HTMLHeadingElement>('#enquiry-title')!;
  const back = document.querySelector<HTMLButtonElement>('#enquiry-back')!;
  const custom = document.querySelector<HTMLTextAreaElement>('#custom-request')!;
  const send = document.querySelector<HTMLAnchorElement>('#whatsapp-send')!;
  type Step = 'start' | 'platform' | 'custom' | 'confirm';
  let history: Step[] = [];
  let step: Step = 'start';
  const headings = { start: 'How can I help?', platform: 'Which platform?', custom: 'Tell me a little more.', confirm: 'Ready to say hello?' };
  function show(next: Step, remember = true) {
    if (remember) history.push(step);
    step = next;
    dialog.querySelectorAll<HTMLElement>('[data-step]').forEach(panel => { panel.hidden = panel.dataset.step !== next; });
    title.textContent = headings[next];
    back.hidden = history.length === 0;
    title.focus();
  }
  function confirmMessage(message: string) {
    document.querySelector('#message-preview')!.textContent = message;
    send.href = 'https://wa.me/6282273612856?text=' + encodeURIComponent(message);
    show('confirm');
  }
  document.querySelector('#enquiry-open')!.addEventListener('click', event => {
    event.preventDefault();
    history = [];
    custom.value = '';
    custom.setCustomValidity('');
    dialog.showModal();
    show('start', false);
  });
  document.querySelector('#enquiry-close')!.addEventListener('click', () => dialog.close());
  document.querySelector('#choose-paid')!.addEventListener('click', () => show('platform'));
  dialog.querySelectorAll<HTMLButtonElement>('[data-other]').forEach(button => button.addEventListener('click', () => show('custom')));
  dialog.querySelectorAll<HTMLButtonElement>('[data-platform]').forEach(button => button.addEventListener('click', () => {
    confirmMessage(`Hi Radhi! I want to do Paid Ads on ${button.dataset.platform}. Could you tell me more about your services and how we can get started?`);
  }));
  custom.addEventListener('input', () => custom.setCustomValidity(''));
  document.querySelector('#custom-form')!.addEventListener('submit', event => {
    event.preventDefault();
    if (!custom.value.trim()) {
      custom.setCustomValidity('Please tell me what you would like to discuss.');
      custom.reportValidity();
      return;
    }
    confirmMessage(`Hi Radhi! I'd like to ask about: ${custom.value.trim()}`);
  });
  back.addEventListener('click', () => {
    const previous = history.pop();
    if (previous) show(previous, false);
  });

  if ('IntersectionObserver' in window && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const revealItems = document.querySelectorAll<HTMLElement>('[data-reveal]');
    const revealObserver = new IntersectionObserver((entries, observer) => {
      entries.forEach(entry => {
        if (!entry.isIntersecting) return;
        entry.target.classList.add('is-visible');
        observer.unobserve(entry.target);
      });
    }, { threshold: 0.12, rootMargin: '0px 0px -30px 0px' });
    revealItems.forEach(item => revealObserver.observe(item));
    document.documentElement.classList.add('motion-ready');
  }
</script>

<style>
  .page {
    min-height: 100svh;
    min-height: 100dvh;
    padding: max(16px, env(safe-area-inset-top)) 24px max(16px, env(safe-area-inset-bottom));
    text-align: center;
  }
  .hint { font-size: 14px; }
  dialog { width: min(440px, calc(100% - 32px)); max-height: calc(100dvh - 32px); overflow-y: auto; padding: 24px; border: 1px solid var(--blue); border-radius: 14px; background: #07111a; color: var(--ink); }
  dialog::backdrop { background: #000b; backdrop-filter: blur(5px); }
  dialog [hidden] { display: none !important; }
  .dialog-heading { display: flex; align-items: center; justify-content: space-between; }
  .dialog-heading .eyebrow { margin: 0; }
  .close { min-width: 44px; min-height: 44px; background: transparent; color: var(--ink); border: 0; font-size: 28px; cursor: pointer; }
  h2 { font: 600 30px/1.15 'Rajdhani', Arial, sans-serif; margin: 8px 0 22px; }
  .choices { display: grid; gap: 12px; }
  dialog .button { width: 100%; cursor: pointer; }
  label, .dialog-copy { font-size: 15px; line-height: 1.5; }
  textarea { width: 100%; margin: 12px 0; padding: 12px; resize: vertical; min-height: 110px; border: 1px solid var(--line); border-radius: 6px; background: #000; color: var(--ink); font: 16px/1.5 Arial, sans-serif; }
  #message-preview { white-space: pre-wrap; overflow-wrap: anywhere; font-size: 16px; line-height: 1.6; padding: 16px; background: #000; border-left: 2px solid var(--blue); }
  .dialog-note { color: var(--muted); font-size: 13px; line-height: 1.5; }
  .back { min-height: 44px; background: none; border: 0; padding: 10px 0; margin-top: 12px; color: var(--blue); font-size: 15px; cursor: pointer; }
  button:focus-visible, textarea:focus-visible { outline: 2px solid var(--blue); outline-offset: 4px; }
  :global(body:has(dialog[open])) { overflow: hidden; }
  main { min-height: calc(100svh - 32px); min-height: calc(100dvh - 32px); display: grid; align-content: center; width: 100%; max-width: 660px; margin: 0 auto; padding: 18px 0; }
  .scroll-cue { display: inline-flex; align-items: center; justify-self: center; gap: 12px; min-height: 44px; margin-top: clamp(28px, 6vh, 64px); color: var(--blue); font: 600 15px/1 'Rajdhani', Arial, sans-serif; letter-spacing: 1.5px; text-decoration: none; text-transform: uppercase; }
  .scroll-cue span { display: grid; place-items: center; width: 32px; height: 32px; border: 1px solid var(--blue); border-radius: 50%; font: 20px/1 Arial, sans-serif; transition: transform .25s ease, background .25s ease; }
  .scroll-cue:hover span { transform: translateY(4px); background: #102333; }
  .portrait { width: clamp(110px, 22svh, 210px); aspect-ratio: 1; margin: 0 auto; padding: 6px; border: 2px solid var(--blue); border-radius: 50%; background: #07111a; box-shadow: 0 0 28px #59baf11a; }
  .portrait img { display: block; width: 100%; height: 100%; border-radius: 50%; object-fit: cover; object-position: center; }
  .eyebrow { margin: 18px 0 10px; font: 600 14px/1.2 'Rajdhani', Arial, sans-serif; letter-spacing: 2px; color: var(--blue); }
  h1 { font: 600 clamp(40px, calc(8.5vw + 4px), 68px)/1.15 'Rajdhani', Arial, sans-serif; letter-spacing: -1px; margin: 0; }
  h1 em { font-weight: 600; font-style: normal; color: var(--accent); }
  .description { font-size: 17px; line-height: 1.5; color: var(--muted); margin: 14px 0 20px; }
  .links { display: grid; gap: 10px; width: 100%; max-width: 380px; margin: auto; }
  .button { min-height: 48px; display: flex; flex-wrap: wrap; align-items: center; justify-content: center; gap: 8px; padding: 10px; font: 600 20px/1.2 'Rajdhani', Arial, sans-serif; text-decoration: none; border: 1px solid var(--accent); border-radius: 6px; transition: transform .25s ease, background .25s ease, border-color .25s ease; }
  .button:hover { transform: translateY(-2px); }
  .primary { background: var(--accent); color: var(--paper); }
  .primary:hover { background: #f6e68a; border-color: #f6e68a; }
  .secondary { border-color: var(--blue); color: var(--blue); background: #07111a; }
  .secondary:hover { background: #102333; }
  .handle { color: var(--muted); font-size: 14px; }
  .case-study { position: relative; isolation: isolate; overflow: hidden; width: min(1120px, 100%); margin: 64px auto 46px; padding: clamp(28px, 5vw, 64px); text-align: left; border: 1px solid var(--line); border-radius: 10px; background: linear-gradient(135deg, #07111a 0%, #000 65%); scroll-margin-top: 28px; }
  .case-study::before { content: ''; position: absolute; top: 0; left: 0; width: clamp(90px, 24%, 250px); height: 3px; background: var(--accent); box-shadow: 0 0 24px #ead97199; }
  .case-heading { max-width: 690px; }
  .case-heading .eyebrow { margin-top: 0; }
  .case-heading h2 { margin: 0; font: 600 clamp(42px, 7vw, 72px)/1 'Rajdhani', Arial, sans-serif; letter-spacing: -1px; }
  .case-heading h2 em { font-style: normal; color: var(--accent); }
  .case-heading h2::after { content: ''; display: block; width: min(100%, 430px); height: 1px; margin-top: 20px; background: linear-gradient(90deg, var(--accent), transparent); transform-origin: left; }
  .case-intro { max-width: 540px; margin: 16px 0 0; color: var(--muted); font-size: clamp(17px, 2vw, 20px); line-height: 1.5; }
  .case-grid { display: grid; grid-template-columns: minmax(0, 1.1fr) minmax(300px, .9fr); gap: clamp(32px, 7vw, 90px); margin-top: clamp(38px, 6vw, 66px); }
  .case-story h3, .funnel h3 { margin: 0 0 10px; font: 600 24px/1.15 'Rajdhani', Arial, sans-serif; color: var(--blue); letter-spacing: .3px; }
  .case-story p { margin: 0 0 28px; color: var(--muted); font-size: 16px; line-height: 1.65; }
  .channels { display: flex; flex-wrap: wrap; gap: 8px; padding: 0; margin: 0; list-style: none; }
  .channels li { padding: 7px 10px; border: 1px solid #2d536b; border-radius: 999px; color: var(--blue); font: 600 15px/1 'Rajdhani', Arial, sans-serif; }
  .results { padding: clamp(22px, 4vw, 34px); border-left: 2px solid var(--accent); background: #0a0e12; box-shadow: 0 16px 55px #0008; }
  .results-label { margin: 0 0 22px; color: var(--accent); font: 600 14px/1.2 'Rajdhani', Arial, sans-serif; letter-spacing: 1.8px; text-transform: uppercase; }
  .results dl { display: grid; gap: 22px; margin: 0; }
  .results dl div { display: grid; grid-template-columns: minmax(112px, auto) 1fr; align-items: baseline; gap: 12px; padding-bottom: 8px; border-bottom: 1px solid #1c2a35; transition: border-color .25s ease, transform .25s ease; }
  .results dl div:hover { transform: translateX(4px); border-color: var(--blue); }
  .results dt { color: var(--ink); font: 600 clamp(30px, 4vw, 42px)/1 'Rajdhani', Arial, sans-serif; white-space: nowrap; }
  .results dd { margin: 0; color: var(--muted); font-size: 15px; line-height: 1.3; }
  .results-note { margin: 28px 0 0; padding-top: 20px; border-top: 1px solid var(--line); color: var(--muted); font-size: 15px; line-height: 1.6; }
  .funnel { display: grid; grid-template-columns: minmax(200px, .7fr) minmax(0, 1.3fr); gap: 32px; margin-top: clamp(46px, 7vw, 80px); padding-top: clamp(30px, 5vw, 54px); border-top: 1px solid var(--line); }
  .funnel .eyebrow { margin: 0 0 10px; }
  .funnel h3 { color: var(--ink); font-size: clamp(25px, 3vw, 34px); }
  .funnel ol { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 16px 28px; padding: 0; margin: 0; list-style: none; }
  .funnel li { padding: 15px 0; border-top: 1px solid #2a3a47; color: var(--ink); font: 600 18px/1.3 'Rajdhani', Arial, sans-serif; }
  .funnel li span { display: block; margin-bottom: 7px; color: var(--blue); font-size: 13px; letter-spacing: 1px; }
  footer { margin-top: 12px; color: var(--muted); font-size: 13px; line-height: 1.4; }
  footer span { margin: 0 6px; }
  :global(.motion-ready) [data-reveal] { opacity: 0; transform: translateY(28px); transition: opacity .7s ease, transform .7s cubic-bezier(.2,.75,.25,1); }
  :global(.motion-ready) [data-reveal].is-visible { opacity: 1; transform: translateY(0); }
  :global(.motion-ready) .case-heading h2::after { transform: scaleX(0); transition: transform .8s ease .25s; }
  :global(.motion-ready) .case-heading.is-visible h2::after { transform: scaleX(1); }
  @media (prefers-reduced-motion: reduce) {
    .button, .scroll-cue span, .results dl div, [data-reveal] { transition: none !important; }
    .button:hover, .scroll-cue:hover span, .results dl div:hover { transform: none; }
  }
  @media (max-height: 700px) {
    .page { padding-top: 12px; padding-bottom: max(12px, env(safe-area-inset-bottom)); }
    main { padding: 12px 0; }
    .portrait { width: clamp(88px, 20svh, 135px); }
    .eyebrow { margin: 14px 0 8px; }
    h1 { font-size: clamp(36px, calc(8vw + 4px), 52px); }
    .description { margin: 12px 0 16px; }
  }
  @media (max-height: 480px) and (min-width: 600px) {
    .page { padding: 10px 24px; }
    main { max-width: 620px; display: grid; grid-template-columns: 140px 1fr; column-gap: 28px; align-items: center; }
    .portrait { grid-column: 1; grid-row: 1 / 5; width: 130px; }
    .eyebrow, h1, .description, .links { grid-column: 2; }
    .eyebrow { margin: 0 0 8px; }
    h1 { font-size: 40px; }
    .description { margin: 8px 0 12px; }
    .links { gap: 6px; }
    .button { min-height: 44px; padding: 8px 12px; }
  }
  @media (max-width: 600px) {
    .page { padding-left: 16px; padding-right: 16px; }
    main { min-height: calc(100svh - 32px); min-height: calc(100dvh - 32px); }
    .case-study { margin-top: 40px; padding: 28px 20px; }
    .case-grid, .funnel { grid-template-columns: 1fr; }
    .case-grid { gap: 34px; }
    .funnel { gap: 24px; }
    .funnel ol { grid-template-columns: 1fr; gap: 0; }
  }
  @media (max-height: 600px) and (max-width: 599px) {
    main { padding: 6px 0; }
    .portrait { width: 80px; }
    .eyebrow { margin: 10px 0 6px; }
    .description { margin: 8px 0 12px; }
    .links { gap: 6px; }
  }
</style>
