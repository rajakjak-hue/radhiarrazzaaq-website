---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import portrait from '../../images/Profile Pic-1.jpeg';
---

<Layout>
  <div class='page'>
    <header><a class='logo' href='/' aria-label='Radhi Arrazzaaq home'>RA<span>.</span></a></header>
    <main id='main'>
      <div class='portrait'>
        <Image src={portrait} alt='Radhi Arrazzaaq' widths={[240, 480, 640]} sizes='(max-height: 600px) 110px, (max-width: 600px) 160px, 220px' width={640} format='webp' loading='eager' fetchpriority='high' />
      </div>
      <p class='eyebrow'>A LITTLE INTRODUCTION</p>
      <h1>Radhi <em>Arrazzaaq.</em></h1>
      <p class='description'>Welcome to my personal space.<br />My portfolio is taking shape. Let's stay connected.</p>
      <nav class='links' aria-label='Connect with Radhi'>
        <a class='button primary' href='https://wa.me/6282273612856' target='_blank' rel='noopener noreferrer'>Say hello on WhatsApp <span aria-hidden='true'>&#8599;</span></a>
        <a class='button secondary' href='https://www.instagram.com/radhiarrazzaaq/' target='_blank' rel='noopener noreferrer'>Instagram <span class='handle'>@radhiarrazzaaq</span><span aria-hidden='true'>&#8599;</span></a>
      </nav>
    </main>
    <footer>&copy; {new Date().getFullYear()} Radhi Arrazzaaq <span aria-hidden='true'>&middot;</span> A space to connect.</footer>
  </div>
</Layout>

<style>
  .page {
    min-height: 100svh;
    min-height: 100dvh;
    display: grid;
    grid-template-rows: auto 1fr auto;
    padding: max(16px, env(safe-area-inset-top)) 24px max(16px, env(safe-area-inset-bottom));
    text-align: center;
  }
  header { line-height: 1; }
  .logo { font: 700 32px/1 'Rajdhani', Arial, sans-serif; letter-spacing: -1px; text-decoration: none; }
  .logo span { color: var(--accent); }
  main { align-self: center; width: 100%; max-width: 660px; margin: 0 auto; padding: 18px 0; }
  .portrait { width: clamp(110px, 22svh, 210px); aspect-ratio: 1; margin: 0 auto; padding: 6px; border: 2px solid var(--blue); border-radius: 50%; background: #07111a; box-shadow: 0 0 28px #59baf11a; }
  .portrait img { display: block; width: 100%; height: 100%; border-radius: 50%; object-fit: cover; object-position: center; }
  .eyebrow { margin: 18px 0 10px; font: 600 14px/1.2 'Rajdhani', Arial, sans-serif; letter-spacing: 2px; color: var(--blue); }
  h1 { font: 600 clamp(40px, calc(8.5vw + 4px), 68px)/1.15 'Rajdhani', Arial, sans-serif; letter-spacing: -1px; margin: 0; }
  h1 em { font-weight: 600; font-style: normal; color: var(--accent); }
  .description { font-size: 17px; line-height: 1.5; color: var(--muted); margin: 14px 0 20px; }
  .links { display: grid; gap: 10px; width: 100%; max-width: 380px; margin: auto; }
  .button { min-height: 48px; display: flex; flex-wrap: wrap; align-items: center; justify-content: center; gap: 8px; padding: 10px; font: 600 20px/1.2 'Rajdhani', Arial, sans-serif; text-decoration: none; border: 1px solid var(--accent); border-radius: 6px; }
  .primary { background: var(--accent); color: var(--paper); }
  .primary:hover { background: #f6e68a; border-color: #f6e68a; }
  .secondary { border-color: var(--blue); color: var(--blue); background: #07111a; }
  .secondary:hover { background: #102333; }
  .handle { color: var(--muted); font-size: 14px; }
  footer { color: var(--muted); font-size: 13px; line-height: 1.4; }
  footer span { margin: 0 6px; }
  @media (max-height: 700px) {
    .page { padding-top: 12px; padding-bottom: max(12px, env(safe-area-inset-bottom)); }
    main { padding: 12px 0; }
    .portrait { width: clamp(88px, 20svh, 135px); }
    .eyebrow { margin: 14px 0 8px; }
    h1 { font-size: clamp(36px, calc(8vw + 4px), 52px); }
    .description { margin: 12px 0 16px; }
  }
  @media (max-height: 480px) and (min-width: 600px) {
    .page { padding: 10px 24px; }
    main { max-width: 620px; display: grid; grid-template-columns: 140px 1fr; column-gap: 28px; align-items: center; }
    .portrait { grid-column: 1; grid-row: 1 / 5; width: 130px; }
    .eyebrow, h1, .description, .links { grid-column: 2; }
    .eyebrow { margin: 0 0 8px; }
    h1 { font-size: 40px; }
    .description { margin: 8px 0 12px; }
    .links { gap: 6px; }
    .button { min-height: 44px; padding: 8px 12px; }
  }
  @media (max-width: 600px) {
    .page { padding-left: 16px; padding-right: 16px; }
  }
  @media (max-height: 600px) and (max-width: 599px) {
    main { padding: 6px 0; }
    .portrait { width: 80px; }
    .eyebrow { margin: 10px 0 6px; }
    .description { margin: 8px 0 12px; }
    .links { gap: 6px; }
  }
</style>
