---
import Layout from '../layouts/Layout.astro';
---
<Layout>
  <div class='page'>
    <header><a class='logo' href='/' aria-label='Radhi Arrazzaaq home'>RA<span>.</span></a><span class='note'>A little introduction.</span><a href='#connect'>Let's connect &#8599;</a></header>
    <main id='main'>
      <section class='hero' aria-labelledby='title'>
        <div>
          <p class='eyebrow'>WELCOME TO MY CORNER OF THE INTERNET</p>
          <h1 id='title'>Radhi<br /><em>Arrazzaaq.</em></h1>
          <p class='description'>Hi, I'm Radhi. Welcome to my personal space.<br />My portfolio is taking shape. In the meantime,<br class='desktop' /> let's get to know each other.</p>
          <a class='button' href='https://wa.me/6282273612856' target='_blank' rel='noopener noreferrer'>Say hello on WhatsApp <span aria-hidden='true'>&#8599;</span></a>
          <a class='instagram' href='https://www.instagram.com/radhiarrazzaaq/' target='_blank' rel='noopener noreferrer'>Find me on Instagram &#8599;</a>
        </div>
        <div class='art' aria-hidden='true'>
          <div class='art-top'>RADHI ARRAZZAAQ <span>01 / INTRODUCTION</span></div>
          <div class='arch'><div class='orb'></div><div class='monogram'>R<span>A</span></div></div>
          <div class='art-bottom'>A space to connect.<span>PERSONAL PORTFOLIO</span></div>
        </div>
      </section>
      <section id='connect' class='connect' aria-labelledby='connect-title'>
        <div><p class='eyebrow'>KEEP IN TOUCH</p><h2 id='connect-title'>Every connection<br />starts with <em>hello.</em></h2></div>
        <div class='links'>
          <a href='https://www.instagram.com/radhiarrazzaaq/' target='_blank' rel='noopener noreferrer'><div>Instagram<small>@radhiarrazzaaq</small></div><span aria-hidden='true'>&#8599;</span></a>
          <a href='https://wa.me/6282273612856' target='_blank' rel='noopener noreferrer'><div>WhatsApp<small>+62 822 7361 2856</small></div><span aria-hidden='true'>&#8599;</span></a>
        </div>
      </section>
    </main>
    <footer><span>&copy; {new Date().getFullYear()} Radhi Arrazzaaq</span><span>radhiarrazzaaq.com</span></footer>
  </div>
</Layout>
<style>
  .page{max-width:1440px;margin:auto;padding:0 6%}header{display:flex;align-items:center;justify-content:space-between;min-height:108px;border-bottom:1px solid var(--line);gap:20px}header a{font-size:13px;text-underline-offset:6px}.logo{font: bold 36px Georgia,serif;letter-spacing:-4px;text-decoration:none}.logo span{color:var(--accent)}.note{color:var(--muted);font-size:12px}
  .hero{display:grid;grid-template-columns:1.2fr 1fr;gap:7%;align-items:center;padding:80px 0}.eyebrow{font-size:10px;letter-spacing:2px;line-height:1.8}.hero .eyebrow:before{content:'';display:inline-block;width:6px;height:6px;background:var(--accent);border-radius:50%;margin-right:10px}h1{font:400 clamp(64px,7.7vw,110px)/1.03 Georgia,serif;letter-spacing:-5px;margin:28px 0}em{font-weight:400;color:var(--accent)}.description{color:var(--muted);font-size:15px;line-height:1.9}.button{display:flex;width:fit-content;gap:36px;align-items:center;padding:18px 22px;background:var(--ink);color:var(--paper);font-size:13px;text-decoration:none;margin-top:28px}.button:hover{background:var(--accent)}.instagram{display:block;width:fit-content;font-size:12px;margin-top:22px;text-underline-offset:5px}
  .art{position:relative;min-height:480px;background:#e8e3d8;padding:25px;display:flex;flex-direction:column;justify-content:space-between;overflow:hidden}.art-top,.art-bottom{position:relative;z-index:1;display:flex;justify-content:space-between;gap:10px;font-size:8px;letter-spacing:1px}.art-bottom{font:italic 14px Georgia,serif;letter-spacing:0}.art-bottom span{font:8px Arial,sans-serif;letter-spacing:1px}.arch{position:absolute;width:72%;height:78%;bottom:0;left:14%;border:1px solid #b9b19e;border-radius:180px 180px 0 0;background:linear-gradient(140deg,#d8d0be,#ece7dd)}.orb{width:160px;height:160px;position:absolute;top:50px;right:-50px;border-radius:50%;background:#a9ae91;mix-blend-mode:multiply;opacity:.65}.monogram{position:absolute;top:12%;left:3%;font:clamp(150px,17vw,230px)/1.3 Georgia,serif;letter-spacing:-35px;color:#4c523d}.monogram span{display:inline-block;transform:translateY(70px);color:#767d60}
  .connect{display:grid;grid-template-columns:1fr 1fr;gap:10%;border-top:1px solid var(--line);padding:55px 0 65px;align-items:center;scroll-margin-top:30px}h2{font:400 clamp(32px,3.4vw,46px)/1.2 Georgia,serif;letter-spacing:-1.4px;margin:18px 0 0}.links a{display:flex;align-items:center;justify-content:space-between;border-bottom:1px solid var(--line);padding:21px 0;text-decoration:none}.links a:hover{color:var(--accent)}.links small{display:block;color:var(--muted);font-size:12px;margin-top:8px}.links>a>span{font-size:22px}footer{display:flex;justify-content:space-between;gap:18px;padding:26px 0;border-top:1px solid var(--line);color:var(--muted);font-size:11px}
  @media(max-width:700px){.page{padding:0 7%}header{min-height:84px}.note{display:none}.hero{grid-template-columns:1fr;padding:45px 0;gap:42px}h1{letter-spacing:-3px;font-size:clamp(54px,13vw,88px)}.art{min-height:370px}.monogram{font-size:190px;top:0;left:10%}.connect{grid-template-columns:1fr;gap:25px;padding:38px 0 44px}footer{flex-wrap:wrap}.desktop{display:none}}
</style>
