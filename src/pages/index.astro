---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import portrait from '../../images/Profile Pic-1.jpeg';
---

<Layout>
  <div class='page'>
    <main id='main'>
      <div class='portrait'>
        <Image src={portrait} alt='Radhi Arrazzaaq' widths={[240, 480, 640]} sizes='(max-height: 600px) 110px, (max-width: 600px) 160px, 220px' width={640} format='webp' loading='eager' fetchpriority='high' />
      </div>
      <p class='eyebrow'>Hi! My name is</p>
      <h1>Radhi <em>Arrazzaaq.</em></h1>
      <p class='description'>I do Paid Ads Marketing<br /><span class='hint'>(Click on WhatsApp to ask me)</span></p>
      <nav class='links' aria-label='Connect with Radhi'>
        <a id='enquiry-open' class='button primary' href='https://wa.me/6282273612856' target='_blank' rel='noopener noreferrer' aria-haspopup='dialog'>Say hello on WhatsApp <span aria-hidden='true'>&#8599;</span></a>
        <a class='button secondary' href='https://www.instagram.com/radhiarrazzaaq/' target='_blank' rel='noopener noreferrer'>Instagram <span class='handle'>@radhiarrazzaaq</span><span aria-hidden='true'>&#8599;</span></a>
      </nav>
    </main>
    <footer>&copy; {new Date().getFullYear()} Radhi Arrazzaaq <span aria-hidden='true'>&middot;</span> A space to connect.</footer>
  </div>
  <dialog id='enquiry' aria-labelledby='enquiry-title'>
    <div class='dialog-heading'><p class='eyebrow'>LET'S TALK</p><button id='enquiry-close' class='close' aria-label='Close enquiry' type='button'>&times;</button></div>
    <h2 id='enquiry-title' tabindex='-1'>How can I help?</h2>
    <section data-step='start' class='choices'>
      <button class='button primary' id='choose-paid' type='button'>I want to do Paid Ads</button>
      <button class='button secondary' data-other type='button'>Others — tell me what you need</button>
    </section>
    <section data-step='platform' class='choices' hidden>
      <button class='button primary' data-platform='Google Ads' type='button'>Google Ads</button>
      <button class='button secondary' data-platform='Meta Ads' type='button'>Meta Ads</button>
      <button class='button secondary' data-other type='button'>Others — customize my request</button>
    </section>
    <form data-step='custom' id='custom-form' hidden>
      <label for='custom-request'>What would you like to discuss?</label>
      <textarea id='custom-request' rows='4' maxlength='1000' required placeholder='Tell me about your business or what you need help with...'></textarea>
      <button class='button primary' type='submit'>Review message</button>
    </form>
    <section data-step='confirm' hidden>
      <p class='dialog-copy'>Here's your message to Radhi:</p>
      <p id='message-preview'></p>
      <a id='whatsapp-send' class='button primary' target='_blank' rel='noopener noreferrer'>Continue to WhatsApp &#8599;</a>
      <p class='dialog-note'>WhatsApp will open with this message ready. You can edit it before sending.</p>
    </section>
    <button id='enquiry-back' class='back' type='button' hidden>&larr; Back</button>
  </dialog>
</Layout>

<script>
  const dialog = document.querySelector<HTMLDialogElement>('#enquiry')!;
  const title = document.querySelector<HTMLHeadingElement>('#enquiry-title')!;
  const back = document.querySelector<HTMLButtonElement>('#enquiry-back')!;
  const custom = document.querySelector<HTMLTextAreaElement>('#custom-request')!;
  const send = document.querySelector<HTMLAnchorElement>('#whatsapp-send')!;
  type Step = 'start' | 'platform' | 'custom' | 'confirm';
  let history: Step[] = [];
  let step: Step = 'start';
  const headings = { start: 'How can I help?', platform: 'Which platform?', custom: 'Tell me a little more.', confirm: 'Ready to say hello?' };
  function show(next: Step, remember = true) {
    if (remember) history.push(step);
    step = next;
    dialog.querySelectorAll<HTMLElement>('[data-step]').forEach(panel => { panel.hidden = panel.dataset.step !== next; });
    title.textContent = headings[next];
    back.hidden = history.length === 0;
    title.focus();
  }
  function confirmMessage(message: string) {
    document.querySelector('#message-preview')!.textContent = message;
    send.href = 'https://wa.me/6282273612856?text=' + encodeURIComponent(message);
    show('confirm');
  }
  document.querySelector('#enquiry-open')!.addEventListener('click', event => {
    event.preventDefault();
    history = [];
    custom.value = '';
    custom.setCustomValidity('');
    dialog.showModal();
    show('start', false);
  });
  document.querySelector('#enquiry-close')!.addEventListener('click', () => dialog.close());
  document.querySelector('#choose-paid')!.addEventListener('click', () => show('platform'));
  dialog.querySelectorAll<HTMLButtonElement>('[data-other]').forEach(button => button.addEventListener('click', () => show('custom')));
  dialog.querySelectorAll<HTMLButtonElement>('[data-platform]').forEach(button => button.addEventListener('click', () => {
    confirmMessage(`Hi Radhi! I want to do Paid Ads on ${button.dataset.platform}. Could you tell me more about your services and how we can get started?`);
  }));
  custom.addEventListener('input', () => custom.setCustomValidity(''));
  document.querySelector('#custom-form')!.addEventListener('submit', event => {
    event.preventDefault();
    if (!custom.value.trim()) {
      custom.setCustomValidity('Please tell me what you would like to discuss.');
      custom.reportValidity();
      return;
    }
    confirmMessage(`Hi Radhi! I'd like to ask about: ${custom.value.trim()}`);
  });
  back.addEventListener('click', () => {
    const previous = history.pop();
    if (previous) show(previous, false);
  });
</script>

<style>
  .page {
    min-height: 100svh;
    min-height: 100dvh;
    display: grid;
    grid-template-rows: 1fr auto;
    padding: max(16px, env(safe-area-inset-top)) 24px max(16px, env(safe-area-inset-bottom));
    text-align: center;
  }
  .hint { font-size: 14px; }
  dialog { width: min(440px, calc(100% - 32px)); max-height: calc(100dvh - 32px); overflow-y: auto; padding: 24px; border: 1px solid var(--blue); border-radius: 14px; background: #07111a; color: var(--ink); }
  dialog::backdrop { background: #000b; backdrop-filter: blur(5px); }
  dialog [hidden] { display: none !important; }
  .dialog-heading { display: flex; align-items: center; justify-content: space-between; }
  .dialog-heading .eyebrow { margin: 0; }
  .close { min-width: 44px; min-height: 44px; background: transparent; color: var(--ink); border: 0; font-size: 28px; cursor: pointer; }
  h2 { font: 600 30px/1.15 'Rajdhani', Arial, sans-serif; margin: 8px 0 22px; }
  .choices { display: grid; gap: 12px; }
  dialog .button { width: 100%; cursor: pointer; }
  label, .dialog-copy { font-size: 15px; line-height: 1.5; }
  textarea { width: 100%; margin: 12px 0; padding: 12px; resize: vertical; min-height: 110px; border: 1px solid var(--line); border-radius: 6px; background: #000; color: var(--ink); font: 16px/1.5 Arial, sans-serif; }
  #message-preview { white-space: pre-wrap; overflow-wrap: anywhere; font-size: 16px; line-height: 1.6; padding: 16px; background: #000; border-left: 2px solid var(--blue); }
  .dialog-note { color: var(--muted); font-size: 13px; line-height: 1.5; }
  .back { min-height: 44px; background: none; border: 0; padding: 10px 0; margin-top: 12px; color: var(--blue); font-size: 15px; cursor: pointer; }
  button:focus-visible, textarea:focus-visible { outline: 2px solid var(--blue); outline-offset: 4px; }
  :global(body:has(dialog[open])) { overflow: hidden; }
  main { align-self: center; width: 100%; max-width: 660px; margin: 0 auto; padding: 18px 0; }
  .portrait { width: clamp(110px, 22svh, 210px); aspect-ratio: 1; margin: 0 auto; padding: 6px; border: 2px solid var(--blue); border-radius: 50%; background: #07111a; box-shadow: 0 0 28px #59baf11a; }
  .portrait img { display: block; width: 100%; height: 100%; border-radius: 50%; object-fit: cover; object-position: center; }
  .eyebrow { margin: 18px 0 10px; font: 600 14px/1.2 'Rajdhani', Arial, sans-serif; letter-spacing: 2px; color: var(--blue); }
  h1 { font: 600 clamp(40px, calc(8.5vw + 4px), 68px)/1.15 'Rajdhani', Arial, sans-serif; letter-spacing: -1px; margin: 0; }
  h1 em { font-weight: 600; font-style: normal; color: var(--accent); }
  .description { font-size: 17px; line-height: 1.5; color: var(--muted); margin: 14px 0 20px; }
  .links { display: grid; gap: 10px; width: 100%; max-width: 380px; margin: auto; }
  .button { min-height: 48px; display: flex; flex-wrap: wrap; align-items: center; justify-content: center; gap: 8px; padding: 10px; font: 600 20px/1.2 'Rajdhani', Arial, sans-serif; text-decoration: none; border: 1px solid var(--accent); border-radius: 6px; }
  .primary { background: var(--accent); color: var(--paper); }
  .primary:hover { background: #f6e68a; border-color: #f6e68a; }
  .secondary { border-color: var(--blue); color: var(--blue); background: #07111a; }
  .secondary:hover { background: #102333; }
  .handle { color: var(--muted); font-size: 14px; }
  footer { color: var(--muted); font-size: 13px; line-height: 1.4; }
  footer span { margin: 0 6px; }
  @media (max-height: 700px) {
    .page { padding-top: 12px; padding-bottom: max(12px, env(safe-area-inset-bottom)); }
    main { padding: 12px 0; }
    .portrait { width: clamp(88px, 20svh, 135px); }
    .eyebrow { margin: 14px 0 8px; }
    h1 { font-size: clamp(36px, calc(8vw + 4px), 52px); }
    .description { margin: 12px 0 16px; }
  }
  @media (max-height: 480px) and (min-width: 600px) {
    .page { padding: 10px 24px; }
    main { max-width: 620px; display: grid; grid-template-columns: 140px 1fr; column-gap: 28px; align-items: center; }
    .portrait { grid-column: 1; grid-row: 1 / 5; width: 130px; }
    .eyebrow, h1, .description, .links { grid-column: 2; }
    .eyebrow { margin: 0 0 8px; }
    h1 { font-size: 40px; }
    .description { margin: 8px 0 12px; }
    .links { gap: 6px; }
    .button { min-height: 44px; padding: 8px 12px; }
  }
  @media (max-width: 600px) {
    .page { padding-left: 16px; padding-right: 16px; }
  }
  @media (max-height: 600px) and (max-width: 599px) {
    main { padding: 6px 0; }
    .portrait { width: 80px; }
    .eyebrow { margin: 10px 0 6px; }
    .description { margin: 8px 0 12px; }
    .links { gap: 6px; }
  }
</style>
