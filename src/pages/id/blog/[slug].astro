---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import BlogPostPage from '../../../components/BlogPostPage.astro';
import { blogCopy } from '../../../data/blogCopy';

export async function getStaticPaths() {
  const entries = await getCollection('blog', ({ data }) => !data.draft);
  const indonesianEntries = entries.filter((entry) => entry.data.lang === 'id');

  return indonesianEntries.map((entry) => {
    const translation = entries.find((candidate) =>
      candidate.data.lang === 'en' && candidate.data.translationKey === entry.data.translationKey
    );
    return {
      params: { slug: entry.data.slug },
      props: { entry, alternateSlug: translation?.data.slug },
    };
  });
}

interface Props {
  entry: CollectionEntry<'blog'>;
  alternateSlug?: string;
}

const { entry, alternateSlug } = Astro.props;
const { Content } = await render(entry);
const alternateUrl = alternateSlug ? `/blog/${alternateSlug}/` : '/blog/';
---

<BlogPostPage locale="id" alternateUrl={alternateUrl} copy={blogCopy.id} entry={entry}>
  <Content />
</BlogPostPage>
