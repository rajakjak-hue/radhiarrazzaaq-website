---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import portrait from '../../images/Profile Pic-1.jpeg';
import type { HomeCopy } from '../data/homeCopy';

interface Props {
  locale: 'en' | 'id';
  copy: HomeCopy;
  alternateUrl: string;
  showPortfolio?: boolean;
}

const { locale, copy, alternateUrl, showPortfolio = false } = Astro.props;
const alternateLocale = locale === 'en' ? 'id' : 'en';
---

<Layout locale={locale} alternateUrl={alternateUrl} meta={copy.meta}>
  <div class='page'>
    <nav class='language-switch' aria-label={copy.language.navLabel}>
      <span aria-current='page'>{locale.toUpperCase()}</span>
      <a href={alternateUrl} hreflang={alternateLocale} lang={alternateLocale} aria-label={alternateLocale === 'id' ? copy.language.indonesian : copy.language.english}>{alternateLocale.toUpperCase()}</a>
    </nav>
    {!showPortfolio && <main id='main'>
      <div class='portrait'>
        <Image src={portrait} alt='Radhi Arrazzaaq' widths={[240, 480, 640]} sizes='(max-height: 600px) 110px, (max-width: 600px) 160px, 220px' width={640} format='webp' loading='eager' fetchpriority='high' />
      </div>
      <p class='identity'>{copy.hero.firstName} {copy.hero.lastName}</p>
      <h1><span>{copy.hero.description}</span><span>{copy.hero.descriptionSecond}</span></h1>
      <p class='location'><span aria-hidden='true'>📍</span> {copy.hero.location}</p>
      <nav class='social-links' aria-label={copy.hero.connectLabel}>
        <a href='https://www.instagram.com/radhiarrazzaaq/' target='_blank' rel='noopener noreferrer'>{copy.hero.instagram}</a>
        <a href='https://www.youtube.com/@radhiarrazzaaq' target='_blank' rel='noopener noreferrer'>{copy.hero.youtube}</a>
        <a href='mailto:rajakjak@gmail.com'>{copy.hero.email}</a>
      </nav>
      <div class='links'>
        <a id='enquiry-open' class='button primary' href='https://wa.me/6282273612856' target='_blank' rel='noopener noreferrer' aria-haspopup='dialog'>{copy.hero.whatsapp} <span aria-hidden='true'>&#8599;</span></a>
        <a class='button secondary workflow-button' href={locale === 'en' ? '/how-i-work/' : '/id/how-i-work/'}>{copy.hero.workflow}</a>
      </div>
    </main>}
    {showPortfolio && <>
    <section class='case-study' aria-labelledby='case-title'>
      <div class='case-heading' data-reveal>
        <p class='eyebrow'>{copy.caseStudy.eyebrow} <span aria-hidden='true'>&middot;</span> {copy.caseStudy.period}</p>
        <h2 id='case-title'>{copy.caseStudy.titleStart} <em>{copy.caseStudy.titleHighlight}</em></h2>
        <p class='case-intro'>{copy.caseStudy.intro}</p>
      </div>

      <div class='case-grid'>
        <section class='case-story' aria-labelledby='case-challenge' data-reveal>
          <h3 id='case-challenge'>{copy.caseStudy.challengeTitle}</h3>
          <p>{copy.caseStudy.challenge}</p>
          <h3>{copy.caseStudy.approachTitle}</h3>
          <p>{copy.caseStudy.approach}</p>
          <ul class='channels' aria-label={copy.caseStudy.channelsLabel}>
            {copy.caseStudy.channels.map(channel => <li>{channel}</li>)}
          </ul>
        </section>

        <section class='results' aria-labelledby='results-title' data-reveal>
          <p id='results-title' class='results-label'>{copy.caseStudy.resultsLabel}</p>
          <dl>
            {copy.caseStudy.results.map(result => <div><dt>{result.value}</dt><dd>{result.label}</dd></div>)}
          </dl>
          <p class='results-note'>{copy.caseStudy.resultsNote}</p>
        </section>
      </div>

      <section class='funnel' aria-labelledby='funnel-title' data-reveal>
        <div>
          <p class='eyebrow'>{copy.caseStudy.roleEyebrow}</p>
          <h3 id='funnel-title'>{copy.caseStudy.roleTitle}</h3>
        </div>
        <ol>
          {copy.caseStudy.roleSteps.map((roleStep, index) => <li><span>{String(index + 1).padStart(2, '0')}</span> {roleStep}</li>)}
        </ol>
      </section>
    </section>
    <footer>&copy; {new Date().getFullYear()} Radhi Arrazzaaq <span aria-hidden='true'>&middot;</span> {copy.footer}</footer>
    </>}
  </div>
  <dialog id='enquiry' aria-labelledby='enquiry-title' data-copy={JSON.stringify(copy.enquiry)}>
    <div class='dialog-heading'><p class='eyebrow'>{copy.enquiry.eyebrow}</p><button id='enquiry-close' class='close' aria-label={copy.enquiry.closeLabel} type='button'>&times;</button></div>
    <h2 id='enquiry-title' tabindex='-1'>{copy.enquiry.headings.start}</h2>
    <section data-step='start' class='choices'>
      <button class='button primary' id='choose-paid' type='button'>{copy.enquiry.choosePaid}</button>
      <button class='button secondary' data-other type='button'>{copy.enquiry.chooseOther}</button>
    </section>
    <section data-step='issue' class='choices' hidden>
      <button class='button primary' data-issue={copy.enquiry.issueLeadQuality} type='button'>{copy.enquiry.issueLeadQuality}</button>
      <button class='button secondary' data-issue={copy.enquiry.issueTrialBookings} type='button'>{copy.enquiry.issueTrialBookings}</button>
      <button class='button secondary' data-issue={copy.enquiry.issueFollowUp} type='button'>{copy.enquiry.issueFollowUp}</button>
      <button class='button secondary' data-issue={copy.enquiry.issueNotSure} type='button'>{copy.enquiry.issueNotSure}</button>
      <button class='button secondary' data-other type='button'>{copy.enquiry.chooseOther}</button>
    </section>
    <form data-step='custom' id='custom-form' hidden>
      <label for='custom-request'>{copy.enquiry.customLabel}</label>
      <textarea id='custom-request' rows='4' maxlength='1000' required placeholder={copy.enquiry.customPlaceholder}></textarea>
      <button class='button primary' type='submit'>{copy.enquiry.reviewMessage}</button>
    </form>
    <section data-step='confirm' hidden>
      <p class='dialog-copy'>{copy.enquiry.preview}</p>
      <p id='message-preview'></p>
      <a id='whatsapp-send' class='button primary' target='_blank' rel='noopener noreferrer'>{copy.enquiry.continueWhatsapp} &#8599;</a>
      <p class='dialog-note'>{copy.enquiry.note}</p>
    </section>
    <button id='enquiry-back' class='back' type='button' hidden>&larr; {copy.enquiry.back}</button>
  </dialog>
</Layout>

<script>
  const dialog = document.querySelector<HTMLDialogElement>('#enquiry')!;
  const title = document.querySelector<HTMLHeadingElement>('#enquiry-title')!;
  const back = document.querySelector<HTMLButtonElement>('#enquiry-back')!;
  const custom = document.querySelector<HTMLTextAreaElement>('#custom-request')!;
  const send = document.querySelector<HTMLAnchorElement>('#whatsapp-send')!;
  type Step = 'start' | 'issue' | 'custom' | 'confirm';
  const enquiryCopy = JSON.parse(dialog.dataset.copy ?? '{}') as {
    headings: Record<Step, string>;
    customRequired: string;
    issueMessage: string;
    customMessage: string;
  };
  let history: Step[] = [];
  let step: Step = 'start';
  function show(next: Step, remember = true) {
    if (remember) history.push(step);
    step = next;
    dialog.querySelectorAll<HTMLElement>('[data-step]').forEach(panel => { panel.hidden = panel.dataset.step !== next; });
    title.textContent = enquiryCopy.headings[next];
    back.hidden = history.length === 0;
    title.focus();
  }
  function confirmMessage(message: string) {
    document.querySelector('#message-preview')!.textContent = message;
    send.href = 'https://wa.me/6282273612856?text=' + encodeURIComponent(message);
    show('confirm');
  }
  document.querySelector('#enquiry-open')!.addEventListener('click', event => {
    event.preventDefault();
    history = [];
    custom.value = '';
    custom.setCustomValidity('');
    dialog.showModal();
    show('start', false);
  });
  document.querySelector('#enquiry-close')!.addEventListener('click', () => dialog.close());
  document.querySelector('#choose-paid')!.addEventListener('click', () => show('issue'));
  dialog.querySelectorAll<HTMLButtonElement>('[data-other]').forEach(button => button.addEventListener('click', () => show('custom')));
  dialog.querySelectorAll<HTMLButtonElement>('[data-issue]').forEach(button => button.addEventListener('click', () => {
    confirmMessage(enquiryCopy.issueMessage.replace('{issue}', button.dataset.issue ?? ''));
  }));
  custom.addEventListener('input', () => custom.setCustomValidity(''));
  document.querySelector('#custom-form')!.addEventListener('submit', event => {
    event.preventDefault();
    if (!custom.value.trim()) {
      custom.setCustomValidity(enquiryCopy.customRequired);
      custom.reportValidity();
      return;
    }
    confirmMessage(enquiryCopy.customMessage.replace('{request}', custom.value.trim()));
  });
  back.addEventListener('click', () => {
    const previous = history.pop();
    if (previous) show(previous, false);
  });

  if ('IntersectionObserver' in window && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const revealItems = document.querySelectorAll<HTMLElement>('[data-reveal]');
    const revealObserver = new IntersectionObserver((entries, observer) => {
      entries.forEach(entry => {
        if (!entry.isIntersecting) return;
        entry.target.classList.add('is-visible');
        observer.unobserve(entry.target);
      });
    }, { threshold: 0.12, rootMargin: '0px 0px -30px 0px' });
    revealItems.forEach(item => revealObserver.observe(item));
    document.documentElement.classList.add('motion-ready');
  }

</script>

<style>
  .page {
    position: relative;
    min-height: 100svh;
    min-height: 100dvh;
    padding: max(16px, env(safe-area-inset-top)) 24px max(16px, env(safe-area-inset-bottom));
    text-align: center;
  }
  .language-switch { position: absolute; z-index: 1; top: max(16px, env(safe-area-inset-top)); right: 24px; display: flex; align-items: center; gap: 12px; font: 600 15px/1 'Manrope', Arial, sans-serif; letter-spacing: 1px; }
  .language-switch span { color: var(--accent); }
  .language-switch a { display: grid; place-items: center; min-width: 44px; min-height: 44px; border: 1px solid var(--line); border-radius: 6px; color: var(--blue); text-decoration: none; }
  .language-switch a:hover { background: #102333; }
  .language-switch a:focus-visible { outline: 2px solid var(--blue); outline-offset: 4px; }
  dialog { width: min(440px, calc(100% - 32px)); max-height: calc(100dvh - 32px); overflow-y: auto; padding: 24px; border: 1px solid var(--blue); border-radius: 14px; background: #07111a; color: var(--ink); }
  dialog::backdrop { background: #000b; backdrop-filter: blur(5px); }
  dialog [hidden] { display: none !important; }
  .dialog-heading { display: flex; align-items: center; justify-content: space-between; }
  .dialog-heading .eyebrow { margin: 0; }
  .close { min-width: 44px; min-height: 44px; background: transparent; color: var(--ink); border: 0; font-size: 28px; cursor: pointer; }
  h2 { font: 600 30px/1.15 'Manrope', Arial, sans-serif; margin: 8px 0 22px; }
  .choices { display: grid; gap: 12px; }
  dialog .button { width: 100%; cursor: pointer; }
  label, .dialog-copy { font-size: 15px; line-height: 1.5; }
  textarea { width: 100%; margin: 12px 0; padding: 12px; resize: vertical; min-height: 110px; border: 1px solid var(--line); border-radius: 6px; background: #000; color: var(--ink); font: 16px/1.5 Arial, sans-serif; }
  #message-preview { white-space: pre-wrap; overflow-wrap: anywhere; font-size: 16px; line-height: 1.6; padding: 16px; background: #000; border-left: 2px solid var(--blue); }
  .dialog-note { color: var(--muted); font-size: 13px; line-height: 1.5; }
  .back { min-height: 44px; background: none; border: 0; padding: 10px 0; margin-top: 12px; color: var(--blue); font-size: 15px; cursor: pointer; }
  button:focus-visible, textarea:focus-visible { outline: 2px solid var(--blue); outline-offset: 4px; }
  :global(body:has(dialog[open])) { overflow: hidden; }
  main { min-height: calc(100svh - 32px); min-height: calc(100dvh - 32px); display: grid; grid-template-columns: minmax(0, 1fr); align-content: center; width: 100%; max-width: 660px; margin: 0 auto; padding: 18px 0; }
  .portrait { width: clamp(110px, 22svh, 210px); aspect-ratio: 1; margin: 0 auto; padding: 6px; border: 2px solid var(--blue); border-radius: 50%; background: #07111a; box-shadow: 0 0 28px #59baf11a; }
  .portrait img { display: block; width: 100%; height: 100%; border-radius: 50%; object-fit: cover; object-position: center; }
  .eyebrow { margin: 18px 0 10px; font: 600 14px/1.2 'Manrope', Arial, sans-serif; letter-spacing: 2px; color: var(--blue); }
  .identity { margin: 20px 0 10px; color: var(--accent); font: 700 clamp(16px, 2vw, 19px)/1.2 'Manrope', Arial, sans-serif; letter-spacing: .2px; }
  h1 { max-width: 650px; margin: 0 auto; font: 700 clamp(28px, 4vw, 38px)/1.15 'Manrope', Arial, sans-serif; letter-spacing: -1.2px; text-wrap: balance; }
  h1 span { display: block; }
  h1 span + span { margin-top: 10px; color: var(--blue); font-size: clamp(17px, 2.2vw, 22px); font-weight: 600; letter-spacing: -.4px; }
  .location { display: flex; align-items: center; justify-content: center; gap: 7px; margin: 14px 0 18px; color: var(--muted); font-size: 15px; }
  .social-links { display: flex; flex-wrap: wrap; justify-content: center; gap: 9px; margin-bottom: 20px; }
  .social-links a { display: inline-flex; align-items: center; justify-content: center; min-height: 42px; padding: 8px 15px; border: 1px solid var(--line); border-radius: 999px; color: var(--blue); font: 600 14px/1 'Manrope', Arial, sans-serif; text-decoration: none; transition: transform .2s ease, border-color .2s ease, background .2s ease; }
  .social-links a:hover { transform: translateY(-2px); border-color: var(--blue); background: #102333; }
  .links { display: grid; gap: 9px; width: 100%; max-width: 320px; margin: auto; }
  .button { min-height: 48px; display: flex; flex-wrap: wrap; align-items: center; justify-content: center; gap: 8px; padding: 10px; font: 600 20px/1.2 'Manrope', Arial, sans-serif; text-decoration: none; border: 1px solid var(--accent); border-radius: 6px; transition: transform .25s ease, background .25s ease, border-color .25s ease; }
  .links > .button { min-height: 44px; padding: 9px 14px; font-size: 16px; }
  .button:hover { transform: translateY(-2px); }
  .primary { background: var(--accent); color: var(--paper); }
  .primary:hover { background: #f6e68a; border-color: #f6e68a; }
  .secondary { border-color: var(--blue); color: var(--blue); background: #07111a; }
  .secondary:hover { background: #102333; }
  .handle { color: var(--muted); font-size: 14px; }
  .case-study { position: relative; isolation: isolate; overflow: hidden; width: min(1120px, 100%); margin: 64px auto 46px; padding: clamp(28px, 5vw, 64px); text-align: left; border: 1px solid var(--line); border-radius: 10px; background: linear-gradient(135deg, #07111a 0%, #000 65%); scroll-margin-top: 28px; }
  .case-study::before { content: ''; position: absolute; top: 0; left: 0; width: clamp(90px, 24%, 250px); height: 3px; background: var(--accent); box-shadow: 0 0 24px #ead97199; }
  .case-heading { max-width: 690px; }
  .case-heading .eyebrow { margin-top: 0; }
  .case-heading h2 { margin: 0; font: 600 clamp(42px, 7vw, 72px)/1 'Manrope', Arial, sans-serif; letter-spacing: -1px; }
  .case-heading h2 em { font-style: normal; color: var(--accent); }
  .case-heading h2::after { content: ''; display: block; width: min(100%, 430px); height: 1px; margin-top: 20px; background: linear-gradient(90deg, var(--accent), transparent); transform-origin: left; }
  .case-intro { max-width: 540px; margin: 16px 0 0; color: var(--muted); font-size: clamp(17px, 2vw, 20px); line-height: 1.5; }
  .case-grid { display: grid; grid-template-columns: minmax(0, 1.1fr) minmax(300px, .9fr); gap: clamp(32px, 7vw, 90px); margin-top: clamp(38px, 6vw, 66px); }
  .case-story h3, .funnel h3 { margin: 0 0 10px; font: 600 24px/1.15 'Manrope', Arial, sans-serif; color: var(--blue); letter-spacing: .3px; }
  .case-story p { margin: 0 0 28px; color: var(--muted); font-size: 16px; line-height: 1.65; }
  .channels { display: flex; flex-wrap: wrap; gap: 8px; padding: 0; margin: 0; list-style: none; }
  .channels li { padding: 7px 10px; border: 1px solid #2d536b; border-radius: 999px; color: var(--blue); font: 600 15px/1 'Manrope', Arial, sans-serif; }
  .results { padding: clamp(22px, 4vw, 34px); border-left: 2px solid var(--accent); background: #0a0e12; box-shadow: 0 16px 55px #0008; }
  .results-label { margin: 0 0 22px; color: var(--accent); font: 600 14px/1.2 'Manrope', Arial, sans-serif; letter-spacing: 1.8px; text-transform: uppercase; }
  .results dl { display: grid; gap: 22px; margin: 0; }
  .results dl div { display: grid; grid-template-columns: minmax(112px, auto) 1fr; align-items: baseline; gap: 12px; padding-bottom: 8px; border-bottom: 1px solid #1c2a35; transition: border-color .25s ease, transform .25s ease; }
  .results dl div:hover { transform: translateX(4px); border-color: var(--blue); }
  .results dt { color: var(--ink); font: 600 clamp(30px, 4vw, 42px)/1 'Manrope', Arial, sans-serif; white-space: nowrap; }
  .results dd { margin: 0; color: var(--muted); font-size: 15px; line-height: 1.3; }
  .results-note { margin: 28px 0 0; padding-top: 20px; border-top: 1px solid var(--line); color: var(--muted); font-size: 15px; line-height: 1.6; }
  .funnel { display: grid; grid-template-columns: minmax(200px, .7fr) minmax(0, 1.3fr); gap: 32px; margin-top: clamp(46px, 7vw, 80px); padding-top: clamp(30px, 5vw, 54px); border-top: 1px solid var(--line); }
  .funnel .eyebrow { margin: 0 0 10px; }
  .funnel h3 { color: var(--ink); font-size: clamp(25px, 3vw, 34px); }
  .funnel ol { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 16px 28px; padding: 0; margin: 0; list-style: none; }
  .funnel li { padding: 15px 0; border-top: 1px solid #2a3a47; color: var(--ink); font: 600 18px/1.3 'Manrope', Arial, sans-serif; }
  .funnel li span { display: block; margin-bottom: 7px; color: var(--blue); font-size: 13px; letter-spacing: 1px; }
  footer { margin-top: 12px; color: var(--muted); font-size: 13px; line-height: 1.4; }
  footer span { margin: 0 6px; }
  :global(.motion-ready) [data-reveal] { opacity: 0; transform: translateY(28px); transition: opacity .7s ease, transform .7s cubic-bezier(.2,.75,.25,1); }
  :global(.motion-ready) [data-reveal].is-visible { opacity: 1; transform: translateY(0); }
  :global(.motion-ready) .case-heading h2::after { transform: scaleX(0); transition: transform .8s ease .25s; }
  :global(.motion-ready) .case-heading.is-visible h2::after { transform: scaleX(1); }
  @media (prefers-reduced-motion: reduce) {
    .button, .scroll-cue span, .results dl div, [data-reveal] { transition: none !important; }
    .button:hover, .scroll-cue:hover span, .results dl div:hover { transform: none; }
  }
  @media (max-height: 700px) {
    .page { padding-top: 12px; padding-bottom: max(12px, env(safe-area-inset-bottom)); }
    main { padding: 12px 0; }
    .portrait { width: clamp(88px, 20svh, 135px); }
    .eyebrow { margin: 14px 0 8px; }
    .description { margin: 12px 0 16px; }
  }
  @media (max-height: 480px) and (min-width: 600px) {
    .page { padding: 10px 24px; }
    main { max-width: 620px; display: grid; grid-template-columns: 140px 1fr; column-gap: 28px; align-items: center; }
    .portrait { grid-column: 1; grid-row: 1 / 5; width: 130px; }
    .eyebrow, h1, .description, .links { grid-column: 2; }
    .eyebrow { margin: 0 0 8px; }
    .description { margin: 8px 0 12px; }
    .links { gap: 6px; }
    .button { min-height: 44px; padding: 8px 12px; }
  }
  @media (max-width: 600px) {
    .language-switch { right: 16px; }
    .page { padding-left: 16px; padding-right: 16px; }
    main { min-height: calc(100svh - 32px); min-height: calc(100dvh - 32px); }
    .case-study { margin-top: 40px; padding: 28px 20px; }
    .case-grid, .funnel { grid-template-columns: 1fr; }
    .case-grid { gap: 34px; }
    .funnel { gap: 24px; }
    .funnel ol { grid-template-columns: 1fr; gap: 0; }
  }
  @media (max-height: 600px) and (max-width: 599px) {
    main { padding: 6px 0; }
    .portrait { width: 80px; }
    .eyebrow { margin: 10px 0 6px; }
    .description { margin: 8px 0 12px; }
    .links { gap: 6px; }
  }
</style>
