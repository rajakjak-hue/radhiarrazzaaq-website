---
import Layout from '../layouts/Layout.astro';
import type { HomeCopy } from '../data/homeCopy';

interface Props {
  copy: HomeCopy;
  alternateUrl: string;
}

const { copy, alternateUrl } = Astro.props;
const study = copy.caseStudy;
const meta = {
  title: 'Case Studies | Radhi Arrazzaaq',
  description: study.intro,
  ogTitle: `${study.titleStart} ${study.titleHighlight} | Radhi Arrazzaaq`,
  ogDescription: study.intro,
  skipLink: copy.meta.skipLink,
};
---

<Layout locale='en' alternateUrl={alternateUrl} meta={meta}>
  <div class='page-shell'>
    <header class='site-header'>
      <a class='brand' href='/' aria-label='Radhi Arrazzaaq, home'>Radhi.</a>
      <nav aria-label='Explore'>
        <a href='/work/' aria-current='page'>Case Studies</a>
        <a href='/blog/'>Blog</a>
        <a href='/#enquiry-open'>Contact</a>
      </nav>
      <div class='language-placeholder' role='group' aria-label='Language'>
        <span aria-current='page'>EN</span>
        <span aria-hidden='true'>/</span>
        <button type='button' disabled aria-label='Indonesian version unavailable for now'>ID</button>
      </div>
    </header>

    <main id='main'>
      <article aria-labelledby='case-title'>
        <header class='case-heading'>
          <p class='eyebrow'>{study.eyebrow} <span aria-hidden='true'>&middot;</span> {study.period}</p>
          <h1 id='case-title'>{study.titleStart} <em>{study.titleHighlight}</em></h1>
          <p class='intro'>{study.intro}</p>
        </header>

        <div class='case-grid'>
          <section class='case-story' aria-labelledby='challenge-title'>
            <h2 id='challenge-title'>The Challenge</h2>
            <p>{study.challenge}</p>
          </section>

          <section class='case-story' aria-labelledby='approach-title'>
            <h2 id='approach-title'>What I Did</h2>
            <p>{study.approach}</p>
            <ul class='channels' aria-label={study.channelsLabel}>
              {study.channels.map(channel => <li>{channel}</li>)}
            </ul>
          </section>
        </div>

        <section class='role' aria-labelledby='work-title'>
          <div>
            <p class='eyebrow'>{study.roleEyebrow}</p>
            <h2 id='work-title'>The Work</h2>
            <p class='role-summary'>{study.roleTitle}</p>
          </div>
          <ol>
            {study.roleSteps.map((step, index) => <li><span>{String(index + 1).padStart(2, '0')}</span>{step}</li>)}
          </ol>
        </section>

        <section class='results' aria-labelledby='outcome-title'>
          <div class='results-heading'>
            <p class='eyebrow'>{study.resultsLabel}</p>
            <h2 id='outcome-title'>The Outcome</h2>
            <p>{study.resultsNote}</p>
          </div>
          <dl>
            {study.results.map(result => <div><dt>{result.value}</dt><dd>{result.label}</dd></div>)}
          </dl>
        </section>
      </article>
    </main>
  </div>
</Layout>

<style>
  .page-shell { width: min(1180px, 100%); margin: 0 auto; padding: 10px clamp(18px, 4vw, 56px) 96px; font-family: 'Source Sans 3', Arial, sans-serif; }
  .site-header { display: grid; grid-template-columns: minmax(0, 1fr) auto; align-items: center; gap: 0 12px; min-height: 44px; padding-bottom: 10px; border-bottom: 1px solid var(--line); }
  .brand, .site-header nav a { display: inline-flex; align-items: center; min-height: 44px; text-decoration: none; }
  .brand { color: var(--ink); font-size: 16px; font-weight: 700; letter-spacing: .01em; }
  .brand:hover { color: var(--blue); }
  .site-header nav { grid-column: 1 / -1; grid-row: 2; display: flex; align-items: center; justify-content: center; gap: clamp(14px, 4vw, 28px); }
  .site-header nav a { min-height: 44px; color: var(--blue); font-size: 18px; font-weight: 700; white-space: nowrap; }
  .site-header nav a:hover, .site-header nav a[aria-current='page'] { text-decoration: underline; text-underline-offset: 4px; }
  .site-header nav a[aria-current='page'] { text-decoration-color: var(--accent-strong); text-decoration-thickness: 2px; }
  .language-placeholder { grid-column: 2; grid-row: 1; display: flex; align-items: center; gap: 7px; color: var(--muted); font-size: 14px; font-weight: 700; letter-spacing: .08em; }
  .language-placeholder span[aria-current='page'] { color: var(--ink); border-bottom: 2px solid var(--blue); padding: 4px 0; }
  .language-placeholder button { margin: 0; padding: 4px 0; border: 0; background: none; color: var(--muted); font: inherit; letter-spacing: inherit; opacity: .55; cursor: not-allowed; }
  main { padding-top: clamp(64px, 10vw, 120px); }
  h1, h2, p { margin-top: 0; }
  .eyebrow { margin-bottom: 18px; color: var(--blue); font-size: 12px; font-weight: 700; letter-spacing: .16em; }
  .case-heading { max-width: 820px; }
  h1 { margin-bottom: 24px; font: 700 clamp(52px, 8vw, 92px)/.96 'Source Sans 3', Arial, sans-serif; letter-spacing: -.05em; text-wrap: balance; }
  h1 em { color: var(--blue); font-style: normal; }
  .intro { max-width: 650px; margin-bottom: 0; color: var(--muted); font-size: clamp(18px, 2vw, 21px); line-height: 1.55; }
  .case-grid { display: grid; grid-template-columns: minmax(0, 1.1fr) minmax(280px, .9fr); gap: clamp(36px, 7vw, 90px); margin-top: clamp(84px, 12vw, 148px); }
  .case-story { border-top: 1px solid var(--ink); padding-top: 28px; }
  .case-story h2 { margin-bottom: 12px; font: 700 clamp(30px, 4vw, 40px)/1.05 'Source Sans 3', Arial, sans-serif; }
  .case-story p { max-width: 620px; margin-bottom: 0; color: var(--muted); font-size: 17px; line-height: 1.65; }
  .channels { display: flex; flex-wrap: wrap; gap: 8px; margin: 24px 0 0; padding: 0; list-style: none; }
  .channels li { padding: 8px 11px; border: 1px solid var(--line); color: var(--blue); font-size: 13px; font-weight: 700; }
  .results { display: grid; grid-template-columns: minmax(240px, .8fr) minmax(0, 1.2fr); gap: clamp(32px, 6vw, 72px); margin-top: clamp(90px, 12vw, 150px); padding: clamp(28px, 5vw, 52px); border-top: 5px solid var(--accent); background: var(--surface); }
  .results h2 { margin-bottom: 16px; font: 700 clamp(36px, 5vw, 60px)/1 'Source Sans 3', Arial, sans-serif; letter-spacing: -.04em; }
  .results-heading > p:last-child { max-width: 480px; margin: 0; color: var(--muted); font-size: 15px; line-height: 1.6; }
  .results dl { display: grid; grid-template-columns: 1fr; align-content: start; gap: 20px; margin: 0; }
  .results dl div { padding-bottom: 16px; border-bottom: 1px solid var(--line); }
  .results dt { margin-bottom: 5px; font: 600 clamp(30px, 4vw, 42px)/1 'Newsreader', Georgia, serif; }
  .results dd { margin: 0; color: var(--muted); font-size: 15px; }
  .role { display: grid; grid-template-columns: minmax(220px, .8fr) minmax(0, 1.2fr); gap: clamp(30px, 7vw, 80px); margin-top: clamp(90px, 12vw, 150px); padding-top: 48px; border-top: 1px solid var(--line); }
  .role h2 { max-width: 450px; margin: 0; font: 700 clamp(36px, 5vw, 60px)/1 'Source Sans 3', Arial, sans-serif; letter-spacing: -.04em; }
  .role-summary { max-width: 430px; margin: 18px 0 0; color: var(--muted); font-size: 17px; line-height: 1.5; }
  .role ol { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 22px; margin: 0; padding: 0; list-style: none; }
  .role li { border-top: 1px solid var(--line); padding-top: 18px; font-size: 18px; font-weight: 600; line-height: 1.35; }
  .role li span { display: block; margin-bottom: 12px; color: var(--blue); font-size: 12px; letter-spacing: .1em; }
  @media (min-width: 761px) {
    .site-header { grid-template-columns: minmax(0, 1fr) auto auto; gap: 24px; }
    .site-header nav { grid-column: 2; grid-row: 1; }
    .site-header nav a { min-height: 44px; }
    .language-placeholder { grid-column: 3; grid-row: 1; }
  }
  @media (max-width: 760px) {
    .page-shell { padding-bottom: 64px; }
    main { padding-top: 66px; }
    h1 { font-size: clamp(46px, 12vw, 64px); }
    .case-grid, .role, .results { grid-template-columns: 1fr; gap: 42px; }
    .role ol { grid-template-columns: 1fr; gap: 16px; }
    .results { padding: 24px; }
    .results dl { grid-template-columns: 1fr; }
  }
  @media (max-width: 380px) {
    .brand { font-size: 15px; }
    .site-header nav { gap: 10px; }
    .site-header nav a { font-size: 16px; }
  }
</style>
