---
import Layout from '../layouts/Layout.astro';
import type { HomeCopy } from '../data/homeCopy';

interface Props {
  locale: 'en' | 'id';
  copy: HomeCopy;
  alternateUrl: string;
}

const { locale, copy, alternateUrl } = Astro.props;
const study = copy.caseStudy;
const meta = {
  title: `${locale === 'en' ? 'Case Studies' : 'Studi Kasus'} | Radhi Arrazzaaq`,
  description: study.intro,
  ogTitle: `${study.titleStart} ${study.titleHighlight} | Radhi Arrazzaaq`,
  ogDescription: study.intro,
  skipLink: copy.meta.skipLink,
};
---

<Layout locale={locale} alternateUrl={alternateUrl} meta={meta}>
  <main id='main'>
    <article aria-labelledby='case-title'>
      <header class='hero'>
        <div class='hero-copy'>
          <p class='section-code'>{study.eyebrow} <span aria-hidden='true'>/</span> {study.period}</p>
          <h1 id='case-title'>{study.titleStart} <span>{study.titleHighlight}</span></h1>
          <p class='hero-intro'>{study.intro}</p>
          <ul class='channel-line' aria-label={study.channelsLabel}>
            {study.channels.map(channel => <li>{channel}</li>)}
          </ul>
        </div>

        <div class='hero-system' aria-label={locale === 'en' ? 'Lead system visual placeholder' : 'Placeholder visual sistem lead'}>
          <div class='system-orbit orbit-one'></div>
          <div class='system-orbit orbit-two'></div>
          <div class='system-core'>
            <span>{locale === 'en' ? 'QUALIFIED' : 'TERKUALIFIKASI'}</span>
            <strong>{locale === 'en' ? 'LEAD FLOW' : 'ALUR LEAD'}</strong>
          </div>
          <span class='node node-a'>META</span>
          <span class='node node-b'>GOOGLE</span>
          <span class='node node-c'>FORM</span>
          <span class='node node-d'>WHATSAPP</span>
          <p>{locale === 'en' ? 'VISUAL PLACEHOLDER' : 'PLACEHOLDER VISUAL'}</p>
        </div>
      </header>

      <section class='manifesto' aria-labelledby='challenge-title'>
        <p class='section-code'>01 / {locale === 'en' ? 'THE CHALLENGE' : 'TANTANGANNYA'}</p>
        <h2 id='challenge-title'>{locale === 'en' ? 'More leads were not the finish line.' : 'Lebih banyak lead bukanlah garis akhir.'}</h2>
        <p>{study.challenge}</p>
      </section>

      <section class='system-section' aria-labelledby='approach-title'>
        <div class='section-heading'>
          <p class='section-code'>02 / {locale === 'en' ? 'THE SYSTEM' : 'SISTEMNYA'}</p>
          <h2 id='approach-title'>{locale === 'en' ? 'One connected path from click to conversation.' : 'Satu jalur terhubung dari klik hingga percakapan.'}</h2>
          <p>{study.approach}</p>
        </div>

        <ol class='flow-map'>
          {study.roleSteps.map((step, index) => (
            <li>
              <span class='flow-number'>{String(index + 1).padStart(2, '0')}</span>
              <div class='flow-visual' aria-hidden='true'>
                <span></span><span></span><span></span>
              </div>
              <strong>{step}</strong>
            </li>
          ))}
        </ol>
      </section>

      <section class='feature feature-dark' aria-labelledby='capture-title'>
        <div class='feature-copy'>
          <p class='section-code'>03 / {locale === 'en' ? 'CAPTURE' : 'PENANGKAPAN'}</p>
          <h2 id='capture-title'>{locale === 'en' ? 'Different channels. Clearer intent.' : 'Kanal berbeda. Minat yang lebih jelas.'}</h2>
          <p>{locale === 'en' ? 'Search, instant forms, and WhatsApp created distinct entry points. Each one was shaped around the signal a prospect was already giving.' : 'Pencarian, instant form, dan WhatsApp menjadi titik masuk yang berbeda. Setiap jalur dibentuk berdasarkan sinyal yang sudah diberikan calon pelanggan.'}</p>
        </div>
        <div class='media-placeholder campaign-ui' aria-label={locale === 'en' ? 'Campaign screenshot placeholder' : 'Placeholder screenshot kampanye'}>
          <div class='ui-top'><span></span><span></span><span></span></div>
          <div class='ui-grid'>
            <div class='ui-sidebar'></div>
            <div class='ui-content'>
              <div class='ui-chart'></div>
              <div class='ui-bars'><i></i><i></i><i></i><i></i><i></i></div>
            </div>
          </div>
          <b>{locale === 'en' ? 'CAMPAIGN VISUAL' : 'VISUAL KAMPANYE'}</b>
        </div>
      </section>

      <section class='feature feature-light' aria-labelledby='qualify-title'>
        <div class='feature-copy'>
          <p class='section-code'>04 / {locale === 'en' ? 'QUALIFY' : 'KUALIFIKASI'}</p>
          <h2 id='qualify-title'>{locale === 'en' ? 'Filter before the sales handoff.' : 'Saring sebelum diserahkan ke sales.'}</h2>
          <p>{locale === 'en' ? 'Qualification added context before a lead reached sales, helping the team focus on prospects with clearer intent.' : 'Kualifikasi menambahkan konteks sebelum lead diteruskan ke sales, sehingga tim dapat fokus pada calon pelanggan dengan minat yang lebih jelas.'}</p>
        </div>
        <div class='qualify-board' aria-label={locale === 'en' ? 'Qualification flow placeholder' : 'Placeholder alur kualifikasi'}>
          <div><span>01</span><strong>{locale === 'en' ? 'Need' : 'Kebutuhan'}</strong></div>
          <div><span>02</span><strong>{locale === 'en' ? 'Timing' : 'Waktu'}</strong></div>
          <div><span>03</span><strong>{locale === 'en' ? 'Intent' : 'Minat'}</strong></div>
          <div><span>04</span><strong>{locale === 'en' ? 'Handoff' : 'Penyerahan'}</strong></div>
        </div>
      </section>

      <section class='outcome' aria-labelledby='outcome-title'>
        <div class='outcome-intro'>
          <p class='section-code'>05 / {study.resultsLabel}</p>
          <h2 id='outcome-title'>{locale === 'en' ? 'Built to move qualified conversations forward.' : 'Dibangun untuk mendorong percakapan berkualitas.'}</h2>
          <p>{study.resultsNote}</p>
        </div>
        <dl>
          {study.results.map((result, index) => (
            <div>
              <span>{String(index + 1).padStart(2, '0')}</span>
              <dt>{result.value}</dt>
              <dd>{result.label}</dd>
            </div>
          ))}
        </dl>
      </section>

      <footer class='case-footer'>
        <p>{locale === 'en' ? 'NEXT / LET’S LOOK AT YOUR LEAD FLOW' : 'SELANJUTNYA / MARI LIHAT ALUR LEAD ANDA'}</p>
        <a href={locale === 'en' ? '/#enquiry-open' : '/id/#enquiry-open'}>{copy.hero.whatsapp}<span aria-hidden='true'>↗</span></a>
      </footer>
    </article>
  </main>
</Layout>

<style>
  :global(body) { overflow-x: hidden; }
  main { background: var(--paper); }
  article { overflow: hidden; }
  h1, h2, p { margin-top: 0; }
  .section-code { margin-bottom: 24px; color: var(--blue); font-size: 12px; font-weight: 700; letter-spacing: .18em; text-transform: uppercase; }

  .hero { min-height: calc(100svh - var(--site-header-height)); display: grid; grid-template-columns: minmax(0, .8fr) minmax(420px, 1.2fr); align-items: center; gap: clamp(44px, 6vw, 100px); width: min(1440px, 100%); margin: 0 auto; padding: clamp(70px, 10vw, 138px) clamp(18px, 5vw, 76px); }
  .hero-copy { position: relative; z-index: 2; }
  h1 { max-width: 720px; margin-bottom: 28px; font-size: clamp(66px, 8vw, 126px); line-height: .83; letter-spacing: -.075em; text-wrap: balance; }
  h1 span { display: block; color: var(--blue); }
  .hero-intro { max-width: 580px; margin-bottom: 34px; color: var(--muted); font-size: clamp(18px, 2vw, 24px); line-height: 1.45; }
  .channel-line { display: flex; flex-wrap: wrap; gap: 10px 24px; margin: 0; padding: 18px 0 0; border-top: 1px solid var(--line); list-style: none; }
  .channel-line li { color: var(--ink); font-size: 12px; font-weight: 700; letter-spacing: .1em; text-transform: uppercase; }

  .hero-system { --hero-glow: rgba(89, 186, 241, .6); position: relative; min-height: min(620px, 68vw); display: grid; place-items: center; isolation: isolate; background: radial-gradient(circle at 50% 50%, rgba(89,186,241,.18), transparent 31%), linear-gradient(145deg, #11191f, #020405 74%); clip-path: polygon(8% 0, 100% 0, 92% 100%, 0 100%); color: #f7f5ee; }
  .hero-system::before { content: ''; position: absolute; inset: 0; z-index: -1; opacity: .34; background-image: linear-gradient(rgba(255,255,255,.08) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,.08) 1px, transparent 1px); background-size: 42px 42px; mask-image: radial-gradient(circle, #000, transparent 76%); }
  .hero-system::after { content: ''; position: absolute; width: 32%; height: 1px; left: 8%; top: 9%; background: var(--accent); box-shadow: 0 8px 24px rgba(240,214,94,.65); }
  .hero-system > p { position: absolute; right: 7%; bottom: 5%; margin: 0; color: #8ca0ac; font-size: 10px; font-weight: 700; letter-spacing: .2em; }
  .system-core { width: clamp(166px, 22vw, 250px); aspect-ratio: 1; display: grid; align-content: center; justify-items: center; position: relative; z-index: 3; border: 1px solid rgba(255,255,255,.22); border-radius: 50%; background: #060a0d; box-shadow: 0 0 0 16px rgba(89,186,241,.05), 0 0 80px var(--hero-glow); text-align: center; }
  .system-core span { color: var(--accent); font-size: 10px; font-weight: 700; letter-spacing: .22em; }
  .system-core strong { max-width: 120px; margin-top: 9px; font-size: clamp(22px, 3vw, 34px); line-height: .9; letter-spacing: -.04em; }
  .system-orbit { position: absolute; border: 1px solid rgba(89,186,241,.34); border-radius: 50%; }
  .orbit-one { width: 64%; aspect-ratio: 1; transform: rotate(18deg); }
  .orbit-two { width: 86%; aspect-ratio: 1; transform: rotate(-24deg); border-color: rgba(240,214,94,.22); }
  .node { position: absolute; z-index: 4; padding: 8px 11px; border: 1px solid rgba(255,255,255,.16); background: rgba(5,9,12,.9); color: #b9c8d0; font-size: 9px; font-weight: 700; letter-spacing: .14em; }
  .node-a { left: 12%; top: 24%; }.node-b { right: 10%; top: 30%; }.node-c { left: 18%; bottom: 18%; }.node-d { right: 8%; bottom: 20%; }

  .manifesto { min-height: 86vh; display: grid; align-content: center; justify-items: center; padding: clamp(100px, 16vw, 230px) clamp(22px, 8vw, 130px); background: #050708; color: #f7f5ee; text-align: center; }
  .manifesto .section-code { color: var(--accent); }
  .manifesto h2 { max-width: 1050px; margin-bottom: 40px; font-size: clamp(54px, 8vw, 116px); line-height: .88; letter-spacing: -.065em; text-wrap: balance; }
  .manifesto > p:last-child { max-width: 660px; margin-bottom: 0; color: #a8b3b9; font-size: clamp(18px, 2vw, 23px); line-height: 1.55; }

  .system-section { width: min(1440px, 100%); margin: 0 auto; padding: clamp(100px, 14vw, 190px) clamp(18px, 5vw, 76px); }
  .section-heading { display: grid; grid-template-columns: minmax(0, 1.35fr) minmax(280px, .65fr); gap: clamp(30px, 8vw, 120px); align-items: end; margin-bottom: clamp(72px, 10vw, 130px); }
  .section-heading .section-code { grid-column: 1 / -1; margin-bottom: -12px; }
  .section-heading h2 { margin-bottom: 0; font-size: clamp(50px, 7vw, 98px); line-height: .9; letter-spacing: -.06em; text-wrap: balance; }
  .section-heading > p:last-child { margin-bottom: 4px; color: var(--muted); font-size: 18px; line-height: 1.6; }
  .flow-map { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 1px; margin: 0; padding: 1px; background: var(--line); list-style: none; }
  .flow-map li { min-height: 420px; display: flex; flex-direction: column; padding: 22px; position: relative; overflow: hidden; background: var(--surface-raised); }
  .flow-map li::after { content: '→'; position: absolute; z-index: 4; right: -13px; top: 50%; width: 26px; height: 26px; display: grid; place-items: center; border-radius: 50%; background: var(--accent); color: var(--ink); font-size: 13px; }
  .flow-map li:last-child::after { display: none; }
  .flow-number { color: var(--blue); font-size: 12px; font-weight: 700; letter-spacing: .14em; }
  .flow-visual { flex: 1; display: grid; place-items: center; position: relative; }
  .flow-visual span { position: absolute; border: 1px solid var(--line); border-radius: 50%; }
  .flow-visual span:nth-child(1) { width: 58%; aspect-ratio: 1; }
  .flow-visual span:nth-child(2) { width: 34%; aspect-ratio: 1; background: var(--blue); opacity: .88; }
  .flow-visual span:nth-child(3) { width: 10%; aspect-ratio: 1; background: var(--accent); border: 0; box-shadow: 0 0 24px rgba(240,214,94,.7); }
  .flow-map strong { max-width: 220px; font-size: clamp(20px, 2vw, 27px); line-height: 1.05; letter-spacing: -.025em; }

  .feature { min-height: 92vh; display: grid; grid-template-columns: minmax(280px, .65fr) minmax(0, 1.35fr); align-items: center; gap: clamp(50px, 8vw, 130px); padding: clamp(100px, 13vw, 180px) max(clamp(18px, 5vw, 76px), calc((100vw - 1440px) / 2 + 76px)); }
  .feature-copy h2 { max-width: 620px; margin-bottom: 26px; font-size: clamp(50px, 6.5vw, 94px); line-height: .9; letter-spacing: -.06em; text-wrap: balance; }
  .feature-copy > p:last-child { max-width: 530px; margin-bottom: 0; font-size: 18px; line-height: 1.65; }
  .feature-dark { background: #071015; color: #f7f5ee; }
  .feature-dark .section-code { color: var(--accent); }
  .feature-dark .feature-copy > p:last-child { color: #aab7bd; }
  .media-placeholder { min-height: 580px; position: relative; overflow: hidden; border: 1px solid #29404c; background: #0a141a; box-shadow: 0 40px 90px rgba(0,0,0,.35); }
  .media-placeholder > b { position: absolute; right: 22px; bottom: 18px; color: #79909b; font-size: 10px; letter-spacing: .2em; }
  .ui-top { height: 58px; display: flex; align-items: center; gap: 8px; padding: 0 20px; border-bottom: 1px solid #253942; }
  .ui-top span { width: 8px; height: 8px; border-radius: 50%; background: #405761; }.ui-top span:first-child { background: var(--accent); }
  .ui-grid { min-height: 522px; display: grid; grid-template-columns: 20% 80%; }
  .ui-sidebar { border-right: 1px solid #253942; background-image: repeating-linear-gradient(to bottom, transparent 0 33px, #17272f 34px 35px); }
  .ui-content { padding: 44px; display: grid; align-content: center; gap: 56px; }
  .ui-chart { height: 180px; border-left: 1px solid #314851; border-bottom: 1px solid #314851; background: linear-gradient(170deg, transparent 48%, rgba(89,186,241,.8) 49% 50%, transparent 51%), linear-gradient(155deg, transparent 57%, rgba(240,214,94,.8) 58% 59%, transparent 60%); }
  .ui-bars { height: 110px; display: flex; align-items: end; gap: 12px; }
  .ui-bars i { flex: 1; background: #1e566f; }.ui-bars i:nth-child(1){height:32%}.ui-bars i:nth-child(2){height:54%}.ui-bars i:nth-child(3){height:46%}.ui-bars i:nth-child(4){height:78%;background:var(--accent)}.ui-bars i:nth-child(5){height:91%}

  .feature-light { background: var(--surface); }
  .feature-light .feature-copy > p:last-child { color: var(--muted); }
  .qualify-board { display: grid; grid-template-columns: repeat(2, minmax(0,1fr)); gap: 1px; padding: 1px; background: var(--line); transform: rotate(-2deg); box-shadow: 24px 28px 0 var(--blue); }
  .qualify-board div { min-height: 260px; display: flex; flex-direction: column; justify-content: space-between; padding: clamp(24px, 4vw, 48px); background: var(--surface-raised); }
  .qualify-board span { color: var(--blue); font-size: 12px; font-weight: 700; letter-spacing: .16em; }
  .qualify-board strong { font-size: clamp(30px, 4vw, 56px); line-height: .95; letter-spacing: -.045em; }
  .qualify-board div:last-child { background: var(--accent); }

  .outcome { display: grid; grid-template-columns: minmax(280px, .75fr) minmax(0, 1.25fr); gap: clamp(50px, 9vw, 140px); width: min(1440px, 100%); margin: 0 auto; padding: clamp(110px, 15vw, 210px) clamp(18px, 5vw, 76px); }
  .outcome-intro h2 { margin-bottom: 28px; font-size: clamp(52px, 6.5vw, 94px); line-height: .9; letter-spacing: -.06em; }
  .outcome-intro > p:last-child { max-width: 560px; margin-bottom: 0; color: var(--muted); font-size: 18px; line-height: 1.65; }
  .outcome dl { display: grid; align-content: center; margin: 0; }
  .outcome dl div { display: grid; grid-template-columns: 40px minmax(130px, .65fr) minmax(150px, 1fr); align-items: baseline; gap: 18px; padding: 28px 0; border-top: 1px solid var(--line); }
  .outcome dl div:last-child { border-bottom: 1px solid var(--line); }
  .outcome dl span { color: var(--blue); font-size: 11px; font-weight: 700; }
  .outcome dt { font-size: clamp(36px, 5vw, 68px); font-weight: 700; line-height: .9; letter-spacing: -.055em; }
  .outcome dd { margin: 0; color: var(--muted); font-size: 16px; }

  .case-footer { min-height: 72vh; display: grid; align-content: center; justify-items: start; padding: clamp(100px, 15vw, 210px) max(clamp(18px, 5vw, 76px), calc((100vw - 1440px) / 2 + 76px)); background: var(--blue-deep); color: #f7f5ee; }
  .case-footer p { margin-bottom: 34px; color: var(--accent); font-size: 12px; font-weight: 700; letter-spacing: .18em; }
  .case-footer a { display: flex; align-items: end; gap: clamp(24px, 6vw, 90px); max-width: 1100px; color: inherit; font-size: clamp(50px, 9vw, 132px); font-weight: 700; line-height: .84; letter-spacing: -.07em; text-decoration: none; }
  .case-footer a span { color: var(--accent); font-size: .48em; transform: translateY(-.15em); }
  .case-footer a:hover { color: var(--accent); }

  @media (prefers-reduced-motion: no-preference) {
    .system-orbit { animation: orbit-pulse 7s ease-in-out infinite alternate; }
    .orbit-two { animation-delay: -3s; }
    .system-core { animation: core-glow 3s ease-in-out infinite alternate; }
    .flow-map li, .qualify-board div, .case-footer a { transition: transform .25s ease, background-color .25s ease, color .25s ease; }
    .flow-map li:hover { transform: translateY(-8px); z-index: 5; }
    .qualify-board div:hover { transform: scale(.98); }
    @keyframes orbit-pulse { to { transform: rotate(30deg) scale(1.04); opacity: .65; } }
    @keyframes core-glow { to { box-shadow: 0 0 0 24px rgba(89,186,241,.07), 0 0 120px var(--hero-glow); } }
  }

  @media (max-width: 900px) {
    .hero { grid-template-columns: 1fr; }
    .hero-system { min-height: 620px; }
    .section-heading, .feature, .outcome { grid-template-columns: 1fr; }
    .section-heading .section-code { margin-bottom: 0; }
    .flow-map { grid-template-columns: repeat(2, minmax(0,1fr)); }
    .feature-copy { max-width: 760px; }
    .outcome dl { margin-top: 30px; }
  }

  @media (max-width: 600px) {
    .hero { min-height: auto; padding-top: 72px; }
    h1 { font-size: clamp(58px, 20vw, 88px); }
    .hero-system { min-height: 480px; margin-inline: -18px; clip-path: none; }
    .node { font-size: 8px; }
    .manifesto { min-height: 78vh; }
    .manifesto h2, .section-heading h2, .feature-copy h2, .outcome-intro h2 { font-size: clamp(44px, 13vw, 66px); }
    .flow-map { grid-template-columns: 1fr; }
    .flow-map li { min-height: 340px; }
    .flow-map li::after { top: auto; right: 50%; bottom: -13px; transform: translateX(50%) rotate(90deg); }
    .feature { min-height: auto; padding-block: 100px; }
    .media-placeholder { min-height: 440px; margin-inline: -18px; }
    .ui-grid { min-height: 382px; }.ui-content { padding: 28px; }.ui-chart { height: 145px; }
    .qualify-board { margin: 24px 10px 26px 0; box-shadow: 12px 14px 0 var(--blue); }
    .qualify-board div { min-height: 180px; padding: 22px; }
    .qualify-board strong { font-size: clamp(26px, 8vw, 40px); }
    .outcome dl div { grid-template-columns: 28px 1fr; }
    .outcome dd { grid-column: 2; }
    .case-footer { min-height: 64vh; }
    .case-footer a { font-size: clamp(48px, 15vw, 76px); }
  }
</style>
