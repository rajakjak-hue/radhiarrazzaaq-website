---
import type { CollectionEntry } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import InteriorHeader from './InteriorHeader.astro';
import type { BlogCopy } from '../data/blogCopy';

interface Props {
  locale: 'en' | 'id';
  alternateUrl: string;
  copy: BlogCopy;
  entry: CollectionEntry<'blog'>;
}

const { locale, alternateUrl, copy, entry } = Astro.props;
const dateLocale = locale === 'en' ? 'en-US' : 'id-ID';
const blogUrl = locale === 'en' ? '/blog/' : '/id/blog/';
const publishIso = entry.data.publishDate.toISOString();
const formattedDate = new Intl.DateTimeFormat(dateLocale, {
  day: 'numeric', month: 'long', year: 'numeric',
}).format(entry.data.publishDate);
const whatsappUrl = `https://wa.me/6285158012325?text=${encodeURIComponent(copy.article.ctaMessage)}`;
const meta = {
  title: entry.data.seoTitle,
  description: entry.data.seoDescription,
  ogTitle: entry.data.title,
  ogDescription: entry.data.summary,
  skipLink: copy.meta.skipLink,
  ogType: 'article' as const,
  publishedTime: publishIso,
};
---

<Layout locale={locale} alternateUrl={alternateUrl} meta={meta}>
  <InteriorHeader locale={locale} alternateUrl={alternateUrl} language={copy.language} />
  <main id="main" class="article-page">
    <a class="back-link" href={blogUrl}><span aria-hidden="true">← </span>{copy.article.back}</a>
    <article>
      <header class="article-header">
        <p class="topic">{entry.data.topic}</p>
        <h1>{entry.data.title}</h1>
        <p class="summary">{entry.data.summary}</p>
        <div class="byline">
          <span>{copy.article.author}</span>
          <time datetime={publishIso.slice(0, 10)}>{formattedDate}</time>
        </div>
      </header>
      <div class="article-body"><slot /></div>
      <aside class="article-cta" aria-labelledby="article-cta-title">
        <p class="cta-label">{locale === 'en' ? 'LET\'S TALK' : 'MARI BAHAS'}</p>
        <h2 id="article-cta-title">{copy.article.ctaPrompt}</h2>
        <p>{copy.article.ctaSupporting}</p>
        <a href={whatsappUrl} target="_blank" rel="noopener noreferrer">{copy.article.ctaButton}<span aria-hidden="true"> ↗</span></a>
      </aside>
    </article>
  </main>
</Layout>

<style>
  .article-page{width:min(1180px,calc(100% - 40px));margin:0 auto;padding:48px 0 120px;font-family:Manrope,Arial,sans-serif}
  .back-link{display:inline-block;color:var(--blue);font-size:.78rem;font-weight:800;letter-spacing:.1em;text-transform:uppercase;text-underline-offset:6px}
  .article-header{max-width:920px;margin:clamp(58px,9vw,116px) auto clamp(64px,9vw,112px)}
  .topic{margin:0 0 26px;color:var(--accent);font-size:.76rem;font-weight:800;letter-spacing:.16em;text-transform:uppercase}
  h1{margin:0;font-size:clamp(3rem,7vw,7rem);line-height:.94;letter-spacing:-.065em}
  .summary{max-width:730px;margin:30px 0 0;color:var(--muted);font-size:clamp(1.1rem,2vw,1.38rem);line-height:1.7}
  .byline{display:flex;flex-wrap:wrap;gap:10px 24px;margin-top:34px;color:var(--blue);font-size:.76rem;font-weight:800;letter-spacing:.1em;text-transform:uppercase}
  .byline time{color:var(--muted)}
  .article-body{width:min(720px,100%);margin:0 auto;color:#d7dce3;font-size:clamp(1.03rem,1.5vw,1.14rem);line-height:1.85}
  :global(.article-body>p:first-child){font-size:clamp(1.3rem,2.4vw,1.7rem);line-height:1.55;color:var(--ink)}
  :global(.article-body h2){margin:72px 0 22px;color:var(--ink);font-size:clamp(2rem,4vw,3.25rem);line-height:1.08;letter-spacing:-.045em}
  :global(.article-body h3){margin:48px 0 16px;color:var(--blue);font-size:clamp(1.25rem,2.3vw,1.65rem);line-height:1.25}
  :global(.article-body p){margin:0 0 24px}
  :global(.article-body ul){margin:8px 0 30px;padding-left:24px}
  :global(.article-body li){margin:10px 0;padding-left:7px}
  :global(.article-body li::marker){color:var(--accent)}
  :global(.article-body blockquote){margin:0 0 38px;padding:22px 26px;border-left:4px solid var(--accent);background:#101820;color:var(--ink);font-size:1.2rem;font-weight:700}
  :global(.article-body blockquote p){margin:0}
  :global(.article-body a){color:var(--blue);text-underline-offset:5px}
  :global(.article-body a:hover){color:var(--accent)}
  .article-cta{width:min(820px,100%);margin:clamp(90px,12vw,150px) auto 0;padding:clamp(34px,6vw,68px);border:1px solid var(--line);background:#07131b}
  .cta-label{margin:0 0 18px;color:var(--blue);font-size:.73rem;font-weight:800;letter-spacing:.18em}
  .article-cta h2{max-width:650px;margin:0;font-size:clamp(2rem,4.5vw,4rem);line-height:1.02;letter-spacing:-.05em}
  .article-cta>p:not(.cta-label){max-width:560px;margin:20px 0 0;color:var(--muted);font-size:1.05rem;line-height:1.7}
  .article-cta a{display:inline-block;margin-top:30px;padding:15px 19px;background:var(--accent);color:var(--paper);font-size:.78rem;font-weight:800;letter-spacing:.08em;text-decoration:none;text-transform:uppercase}
  .article-cta a:hover{background:var(--blue)}
  @media (max-width:700px){.article-page{width:min(100% - 28px,1180px);padding-top:34px}.article-header{margin-top:58px}.article-cta{padding:32px 24px}}
  @media (prefers-reduced-motion:no-preference){.article-cta a,.back-link,:global(.article-body a){transition:color .18s ease,background-color .18s ease}}
</style>
