---
import type { CollectionEntry } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import InteriorHeader from './InteriorHeader.astro';
import type { BlogCopy } from '../data/blogCopy';

interface Props {
  locale: 'en' | 'id';
  alternateUrl: string;
  copy: BlogCopy;
  entry: CollectionEntry<'blog'>;
}

const { locale, alternateUrl, copy, entry } = Astro.props;
const dateLocale = locale === 'en' ? 'en-US' : 'id-ID';
const blogUrl = locale === 'en' ? '/blog/' : '/id/blog/';
const publishIso = entry.data.publishDate.toISOString();
const formattedDate = new Intl.DateTimeFormat(dateLocale, {
  day: 'numeric', month: 'long', year: 'numeric',
}).format(entry.data.publishDate);
const whatsappUrl = `https://wa.me/6285158012325?text=${encodeURIComponent(copy.article.ctaMessage)}`;
const meta = {
  title: entry.data.seoTitle,
  description: entry.data.seoDescription,
  ogTitle: entry.data.title,
  ogDescription: entry.data.summary,
  skipLink: copy.meta.skipLink,
  ogType: 'article' as const,
  publishedTime: publishIso,
};
---

<Layout locale={locale} alternateUrl={alternateUrl} meta={meta}>
  <InteriorHeader locale={locale} alternateUrl={alternateUrl} language={copy.language} />
  <main id="main" class="article-page">
    <a class="back-link" href={blogUrl}><span aria-hidden="true">← </span>{copy.article.back}</a>
    <article>
      <header class="article-header">
        <p class="topic">{entry.data.topic}</p>
        <h1>{entry.data.title}</h1>
        <p class="summary">{entry.data.summary}</p>
        <div class="byline">
          <span>{copy.article.author}</span>
          <time datetime={publishIso.slice(0, 10)}>{formattedDate}</time>
        </div>
      </header>
      <div class="article-body"><slot /></div>
      <aside class="article-cta" aria-labelledby="article-cta-title">
        <p class="cta-label">{locale === 'en' ? 'LET\'S TALK' : 'MARI BAHAS'}</p>
        <h2 id="article-cta-title">{copy.article.ctaPrompt}</h2>
        <p>{copy.article.ctaSupporting}</p>
        <a href={whatsappUrl} target="_blank" rel="noopener noreferrer">{copy.article.ctaButton}<span aria-hidden="true"> ↗</span></a>
      </aside>
    </article>
  </main>
</Layout>

<style>
  .article-page{width:min(1180px,calc(100% - 48px));margin:0 auto;padding:52px 0 130px;font-family:'Source Sans 3',Arial,sans-serif}
  .back-link{display:inline-block;color:var(--blue);font-size:16px;font-weight:700;letter-spacing:.08em;text-transform:uppercase;text-underline-offset:6px}
  .article-header{max-width:920px;margin:clamp(58px,9vw,116px) auto clamp(64px,9vw,112px)}
  .topic{margin:0 0 26px;color:var(--blue);font-size:14px;font-weight:700;letter-spacing:.14em;text-transform:uppercase}
  h1{margin:0;font-family:'Newsreader',Georgia,serif;font-size:clamp(58px,7.2vw,110px);font-weight:500;line-height:.97;letter-spacing:-.05em;text-wrap:balance}
  .summary{max-width:730px;margin:30px 0 0;color:var(--muted);font-size:clamp(21px,2.2vw,25px);line-height:1.55}
  .byline{display:flex;flex-wrap:wrap;gap:10px 24px;margin-top:34px;color:var(--blue);font-size:14px;font-weight:700;letter-spacing:.08em;text-transform:uppercase}
  .byline time{color:var(--muted)}
  .article-body{width:min(720px,100%);margin:0 auto;color:#3d494e;font-size:clamp(19px,1.7vw,21px);line-height:1.75}
  :global(.article-body>p:first-child){font-size:clamp(24px,2.5vw,30px);line-height:1.5;color:var(--ink)}
  :global(.article-body h2){margin:76px 0 24px;color:var(--ink);font-family:'Newsreader',Georgia,serif;font-size:clamp(38px,4vw,60px);font-weight:500;line-height:1.07;letter-spacing:-.04em;text-wrap:balance}
  :global(.article-body h3){margin:50px 0 18px;color:var(--blue);font-family:'Newsreader',Georgia,serif;font-size:clamp(28px,2.7vw,36px);font-weight:500;line-height:1.2}
  :global(.article-body p){margin:0 0 24px}
  :global(.article-body ul){margin:8px 0 30px;padding-left:24px}
  :global(.article-body li){margin:10px 0;padding-left:7px}
  :global(.article-body li::marker){color:var(--accent)}
  :global(.article-body blockquote){margin:0 0 42px;padding:26px 30px;border-left:5px solid var(--accent);background:var(--surface);color:var(--ink);font-family:'Newsreader',Georgia,serif;font-size:26px;font-weight:500;line-height:1.35}
  :global(.article-body blockquote p){margin:0}
  :global(.article-body a){color:var(--blue);text-underline-offset:5px}
  :global(.article-body a:hover){color:var(--blue-deep)}
  .article-cta{width:min(820px,100%);margin:clamp(90px,12vw,150px) auto 0;padding:clamp(38px,7vw,74px);border-top:1px solid var(--ink);border-bottom:1px solid var(--line);background:var(--surface);position:relative}
  .article-cta::before{content:'';position:absolute;top:0;left:0;width:110px;height:5px;background:var(--accent)}
  .cta-label{margin:0 0 18px;color:var(--blue);font-size:14px;font-weight:700;letter-spacing:.16em}
  .article-cta h2{max-width:650px;margin:0;font-family:'Newsreader',Georgia,serif;font-size:clamp(42px,4.7vw,72px);font-weight:500;line-height:1;letter-spacing:-.04em;text-wrap:balance}
  .article-cta>p:not(.cta-label){max-width:560px;margin:20px 0 0;color:var(--muted);font-size:20px;line-height:1.6}
  .article-cta a{display:inline-flex;align-items:center;min-height:52px;margin-top:30px;padding:15px 22px;background:var(--accent);color:var(--ink);font-size:18px;font-weight:700;letter-spacing:.05em;text-decoration:none;text-transform:uppercase}
  .article-cta a:hover{background:#e3cc70}
  @media (max-width:700px){.article-page{width:min(100% - 28px,1180px);padding-top:34px}.article-header{margin-top:58px}.article-cta{padding:32px 24px}h1{font-size:clamp(50px,12vw,72px)}.article-body{font-size:19px}:global(.article-body blockquote){padding:22px;font-size:23px}}
  @media (prefers-reduced-motion:no-preference){.article-cta a,.back-link,:global(.article-body a){transition:color .18s ease,background-color .18s ease}}
</style>
