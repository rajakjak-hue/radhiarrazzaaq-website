---
import Layout from '../layouts/Layout.astro';
import type { HowIWorkCopy } from '../data/howIWorkCopy';

interface Props {
  locale: 'en' | 'id';
  copy: HowIWorkCopy;
  alternateUrl: string;
}

const { locale, copy, alternateUrl } = Astro.props;
const whatsappUrl = `https://wa.me/6282273612856?text=${encodeURIComponent(copy.cta.message)}`;
---

<Layout locale={locale} alternateUrl={alternateUrl} meta={copy.meta}>
  <div class:list={['page-shell', 'focused-page']}>

    <main id='main'>
      <section class='hero' aria-labelledby='method-title'>
        <p class='eyebrow'>{copy.hero.eyebrow}</p>
        <h1 id='method-title'>{copy.hero.title}</h1>
        <div class='hero-intro'>{copy.hero.intro.map(paragraph => <p>{paragraph}</p>)}</div>
      </section>

      <section class='journey section' aria-labelledby='journey-title'>
        <p class='eyebrow'>{copy.journey.eyebrow}</p>
        <h2 id='journey-title'>{copy.journey.title}</h2>
        <ol class='journey-list'>
          {copy.journey.steps.map((step, index) => (
            <li class:list={{ owned: index === 4, client: index === 5 }}>
              <span class='journey-number'>{String(index + 1).padStart(2, '0')}</span>
              <strong>{step}</strong>
              {index === 5 && <small>{copy.journey.qualifier}</small>}
              {index < copy.journey.steps.length - 1 && <span class='arrow' aria-hidden='true'>→</span>}
            </li>
          ))}
        </ol>
        <p class='section-note'>{copy.journey.note}</p>
      </section>

      <section class='section' aria-labelledby='leaks-title'>
        <p class='eyebrow'>{copy.leaks.eyebrow}</p>
        <h2 id='leaks-title'>{copy.leaks.title}</h2>
        <ol class='leak-list'>
          {copy.leaks.items.map((item, index) => <li><span>{String(index + 1).padStart(2, '0')}</span><div><h3>{item.title}</h3><p>{item.body}</p></div></li>)}
        </ol>
      </section>

      <section class='section method' aria-labelledby='method-section-title'>
        <p class='eyebrow'>{copy.method.eyebrow}</p>
        <h2 id='method-section-title'>{copy.method.title}</h2>
        <ol class='method-list'>
          {copy.method.items.map((item, index) => <li><span>{String(index + 1).padStart(2, '0')}</span><div><h3>{item.title}</h3><p>{item.body}</p></div></li>)}
        </ol>
      </section>

      <section class='section responsibility' aria-labelledby='responsibility-title'>
        <p class='eyebrow'>{copy.responsibility.eyebrow}</p>
        <h2 id='responsibility-title'>{copy.responsibility.title}</h2>
        <p>{copy.responsibility.body}</p>
      </section>

      <section class='final-cta' aria-labelledby='cta-title'>
        <h2 id='cta-title'>{copy.cta.prompt}</h2>
        <p>{copy.cta.supporting}</p>
        <a class='cta-button' href={whatsappUrl} target='_blank' rel='noopener noreferrer'>{copy.cta.button} <span aria-hidden='true'>↗</span></a>
      </section>
    </main>
  </div>
</Layout>

<style>
  .page-shell { width: min(1180px, 100%); margin: 0 auto; padding: 22px 24px 96px; }
  .orientation { display: flex; align-items: center; justify-content: space-between; min-height: 48px; border-bottom: 1px solid var(--line); }
  .brand { color: var(--ink); font: 600 14px/1 var(--font-body); letter-spacing: .08em; text-transform: uppercase; text-decoration: none; }
  .focused-header { display: grid; grid-template-columns: minmax(0, 1fr) auto; align-items: center; gap: 0 12px; min-height: 54px; }
  .focused-header .brand { display: inline-flex; align-items: center; min-height: 44px; font-size: 16px; font-weight: 700; letter-spacing: .01em; text-transform: none; }
  .focused-header .brand:hover { color: var(--blue); }
  .site-links { grid-column: 1 / -1; grid-row: 2; display: flex; align-items: center; justify-content: center; gap: clamp(14px, 4vw, 28px); }
  .site-links a { display: inline-flex; align-items: center; min-height: 44px; color: var(--blue); font-size: 18px; font-weight: 700; text-decoration: none; white-space: nowrap; }
  .site-links a:hover, .site-links a[aria-current='page'] { text-decoration: underline; text-underline-offset: 4px; }
  .site-links a[aria-current='page'] { text-decoration-color: var(--accent-strong); text-decoration-thickness: 2px; }
  .language-placeholder { grid-column: 2; grid-row: 1; display: flex; align-items: center; gap: 7px; color: var(--muted); font-size: 14px; font-weight: 700; letter-spacing: .08em; }
  .language-placeholder span[aria-current='page'] { color: var(--ink); border-bottom: 2px solid var(--blue); padding: 4px 0; }
  .language-placeholder button { margin: 0; padding: 4px 0; border: 0; background: none; color: var(--muted); font: inherit; letter-spacing: inherit; opacity: .55; cursor: not-allowed; }
  .language-switch { display: flex; align-items: center; gap: 14px; font: 700 12px/1 var(--font-body); letter-spacing: .12em; }
  .language-switch span { color: var(--ink); border-bottom: 1px solid var(--accent-strong); padding-bottom: 7px; }
  .language-switch a { display: grid; place-items: center; min-width: 44px; min-height: 44px; color: var(--blue); text-decoration: none; }
  main { display: grid; gap: clamp(86px, 12vw, 150px); }
  .hero { max-width: 830px; padding-top: clamp(82px, 13vw, 150px); }
  .eyebrow { margin: 0 0 18px; color: var(--blue); font: 700 12px/1.2 var(--font-body); letter-spacing: .16em; }
  h1, h2, h3, p { margin-top: 0; }
  h1 { margin-bottom: 30px; font: 700 clamp(52px, 8vw, 92px)/.96 var(--font-heading); letter-spacing: -.05em; text-wrap: balance; }
  h2 { max-width: 850px; margin-bottom: 42px; font: 700 clamp(38px, 5.4vw, 62px)/1 var(--font-heading); letter-spacing: -.04em; text-wrap: balance; }
  .hero-intro { color: var(--muted); font-size: clamp(18px, 2vw, 21px); line-height: 1.55; }
  .hero-intro p { margin-bottom: 4px; }
  .section { border-top: 1px solid var(--line); padding-top: clamp(42px, 6vw, 70px); }
  .journey-list { display: grid; grid-template-columns: repeat(6, minmax(0, 1fr)); gap: 0; padding: 0; margin: 0; border-top: 1px solid var(--ink); list-style: none; }
  .journey-list li { position: relative; min-height: 154px; padding: 20px 14px; border: 0; border-bottom: 1px solid var(--line); background: transparent; }
  .journey-list strong { display: block; font: 600 16px/1.25 var(--font-body); }
  .journey-number { display: block; margin-bottom: 30px; color: var(--blue); font: 700 12px/1 var(--font-body); letter-spacing: .1em; }
  .journey-list .owned { border: 0; border-bottom: 5px solid var(--accent); background: var(--surface); }
  .journey-list .owned .journey-number { color: var(--blue); }
  .focused-page .journey-list .owned .journey-number { color: var(--blue); }
  .journey-list .client { color: var(--muted); background: transparent; }
  .journey-list small { display: block; margin-top: 12px; color: var(--muted); font: 600 12px/1.3 var(--font-body); text-transform: uppercase; letter-spacing: .8px; }
  .arrow { position: absolute; z-index: 1; top: 50%; right: -19px; color: var(--blue); font-size: 20px; transform: translateY(-50%); }
  .section-note { max-width: 780px; margin: 28px 0 0; padding-left: 18px; border-left: 2px solid var(--accent); color: var(--muted); font-size: 16px; line-height: 1.7; }
  .leak-list { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0 clamp(32px, 6vw, 80px); padding: 0; margin: 0; list-style: none; }
  .leak-list li, .method-list li { display: grid; grid-template-columns: 42px 1fr; gap: 18px; padding: 28px 0; border: 0; border-top: 1px solid var(--line); background: transparent; }
  .leak-list li:last-child { grid-column: 1 / -1; }
  .leak-list span, .method-list span { color: var(--blue); font: 700 12px/1 var(--font-body); letter-spacing: .1em; }
  h3 { margin-bottom: 9px; font: 700 28px/1.1 var(--font-heading); }
  .focused-page h1, .focused-page h2, .focused-page h3 { font-family: var(--font-body); font-weight: 700; }
  .leak-list p, .method-list p, .responsibility > p { margin-bottom: 0; color: var(--muted); font-size: 16px; line-height: 1.65; }
  .method-list { display: grid; gap: 12px; padding: 0; margin: 0; list-style: none; }
  .method-list li { grid-template-columns: 54px minmax(0, 1fr); }
  .method-list h3 { color: var(--ink); }
  .responsibility { max-width: 900px; }
  .responsibility > p { max-width: 760px; font-size: 18px; }
  .final-cta { padding: clamp(38px, 7vw, 76px); border-top: 1px solid var(--ink); border-bottom: 1px solid var(--line); background: var(--surface); position: relative; }
  .final-cta::before { content: ''; position: absolute; top: 0; left: 0; width: 120px; height: 5px; background: var(--accent); }
  .final-cta h2 { margin-bottom: 16px; }
  .final-cta p { max-width: 650px; margin-bottom: 28px; color: var(--muted); font-size: 18px; line-height: 1.6; }
  .cta-button { display: inline-flex; align-items: center; justify-content: center; gap: 10px; min-height: 52px; padding: 15px 22px; border: 1px solid var(--blue-deep); border-radius: 6px; background: var(--blue-deep); color: #fff; font: 700 20px/1.2 var(--font-body); text-decoration: none; transition: background .2s ease, color .2s ease; }
  .cta-button:hover { background: var(--surface-raised); color: var(--blue-deep); }
  @media (min-width: 761px) {
    .focused-header { grid-template-columns: minmax(0, 1fr) auto auto; gap: 24px; }
    .site-links { grid-column: 2; grid-row: 1; }
    .site-links a { min-height: 44px; }
    .language-placeholder { grid-column: 3; grid-row: 1; }
  }
  @media (max-width: 900px) {
    .journey-list { grid-template-columns: 1fr; }
    .journey-list li { min-height: 0; padding: 18px; }
    .journey-number { margin-bottom: 10px; }
    .arrow { top: auto; right: 18px; bottom: -20px; transform: rotate(90deg); }
  }
  @media (max-width: 640px) {
    .page-shell { padding: 14px 16px 48px; }
    main { gap: 76px; }
    .hero { padding-top: 70px; }
    h1 { font-size: clamp(38px, 12vw, 52px); letter-spacing: -1.7px; }
    h2 { margin-bottom: 28px; font-size: clamp(30px, 9vw, 42px); }
    .leak-list { grid-template-columns: 1fr; }
    .leak-list li:last-child { grid-column: auto; }
    .leak-list li, .method-list li { grid-template-columns: 34px 1fr; padding: 20px 16px; gap: 12px; }
    .final-cta { padding: 28px 20px; }
    .cta-button { width: 100%; }
  }
  @media (max-width: 380px) {
    .focused-header .brand { font-size: 15px; }
    .site-links { gap: 10px; }
    .site-links a { font-size: 16px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .cta-button { transition: none; }
    .cta-button:hover { transform: none; }
  }
</style>
