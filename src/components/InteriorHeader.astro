---
interface Props {
  locale: 'en' | 'id';
  alternateUrl: string;
  language: {
    navLabel: string;
    english: string;
    indonesian: string;
  };
}

const { locale, alternateUrl, language } = Astro.props;
const homeUrl = locale === 'en' ? '/' : '/id/';
---

<header class="interior-header">
  <a class="brand" href={homeUrl} aria-label={`Radhi Arrazzaaq, ${locale === 'en' ? 'home' : 'beranda'}`}>
    <span aria-hidden="true">RA</span>
    <span>Radhi Arrazzaaq</span>
  </a>
  <nav class="language-switcher" aria-label={language.navLabel}>
    {locale === 'en' ? (
      <>
        <span aria-current="page">EN</span>
        <a href={alternateUrl} lang="id" hreflang="id" aria-label={language.indonesian}>ID</a>
      </>
    ) : (
      <>
        <a href={alternateUrl} lang="en" hreflang="en" aria-label={language.english}>EN</a>
        <span aria-current="page">ID</span>
      </>
    )}
  </nav>
</header>

<style>
  .interior-header{width:min(1180px,calc(100% - 40px));margin:0 auto;min-height:88px;display:flex;align-items:center;justify-content:space-between;border-bottom:1px solid var(--line)}
  .brand{display:inline-flex;align-items:center;gap:12px;text-decoration:none;font-family:Manrope,Arial,sans-serif;font-size:.9rem;font-weight:800;letter-spacing:.05em;text-transform:uppercase}
  .brand span:first-child{display:grid;place-items:center;width:36px;height:36px;background:var(--accent);color:var(--paper);font-size:.72rem}
  .language-switcher{display:flex;align-items:center;gap:5px;font-family:Manrope,Arial,sans-serif;font-size:.75rem;font-weight:800;letter-spacing:.12em}
  .language-switcher a,.language-switcher span{padding:9px 10px;text-decoration:none;border:1px solid transparent}
  .language-switcher span{color:var(--paper);background:var(--accent)}
  .language-switcher a{color:var(--muted)}
  .language-switcher a:hover{color:var(--blue);border-color:var(--blue)}
  @media (max-width:600px){.interior-header{width:min(100% - 28px,1180px);min-height:72px}.brand span:last-child{display:none}}
</style>
