---
interface Props {
  enquiryTrigger?: boolean;
  locale: 'en' | 'id';
  alternateUrl: string;
}

const { locale, alternateUrl, enquiryTrigger = false } = Astro.props;
const homeUrl = locale === 'en' ? '/' : '/id/';
const prefix = locale === 'en' ? '' : '/id';
const currentPath = Astro.url.pathname.replace(/\/+$/, '');
const isBlogIndex = currentPath === `${prefix}/blog` || currentPath.startsWith(`${prefix}/blog/`);
const isWork = currentPath === `${prefix}/work`;
---

<header class='site-header'>
  <div class='header-inner'>
  <a class='brand' href={homeUrl} aria-label={`Radhi Arrazzaaq, ${locale === 'en' ? 'home' : 'beranda'}`}>
    Radhi.
  </a>
  <nav class='site-links' aria-label={locale === 'en' ? 'Explore' : 'Jelajahi'}>
    <a href={`${prefix}/work/`} aria-current={isWork ? 'page' : undefined}>{locale === 'en' ? 'Case Studies' : 'Studi Kasus'}</a>
    <a href={`${prefix}/blog/`} aria-current={isBlogIndex ? 'page' : undefined}>Blog</a>
    <a href={`${homeUrl}#enquiry-open`} aria-haspopup={enquiryTrigger ? 'dialog' : undefined} data-enquiry-trigger={enquiryTrigger || undefined}>{locale === 'en' ? 'Contact' : 'Kontak'}</a>
  </nav>
  <nav class="language-switcher" data-locale={locale} aria-label={locale === 'en' ? 'Language' : 'Bahasa'}>
    <span class='language-indicator' aria-hidden='true'></span>
    {locale === 'en' ? (
      <>
        <span class='language-option' aria-current="page">EN</span>
        <a class='language-option' href={alternateUrl} lang="id" hreflang="id" aria-label='Indonesian'>ID</a>
      </>
    ) : (
      <>
        <a class='language-option' href={alternateUrl} lang="en" hreflang="en" aria-label='Bahasa Inggris'>EN</a>
        <span class='language-option' aria-current="page">ID</span>
      </>
    )}
  </nav>
  </div>
</header>

<script>
  document.querySelectorAll<HTMLElement>('.language-switcher').forEach((switcher) => {
    const link = switcher.querySelector<HTMLAnchorElement>('a.language-option');
    const indicator = switcher.querySelector<HTMLElement>('.language-indicator');
    if (!link || !indicator) return;
    let navigating = false;
    link.addEventListener('click', async (event) => {
      if (event.defaultPrevented || event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey
        || window.matchMedia('(prefers-reduced-motion: reduce)').matches || !indicator.animate) return;
      event.preventDefault();
      if (navigating) return;
      navigating = true;
      const from = switcher.dataset.locale === 'id' ? '100%' : '0%';
      const to = switcher.dataset.locale === 'id' ? '0%' : '100%';
      const animation = indicator.animate(
        [{ transform: `translateX(${from})` }, { transform: `translateX(${to})` }],
        { duration: 180, easing: 'cubic-bezier(.2,.8,.2,1)', fill: 'forwards' },
      );
      try { await animation.finished; } catch { /* Navigation still works if the animation is interrupted. */ }
      window.location.assign(link.href);
    });
  });
</script>

<style>
  .site-header{width:100%;background:var(--paper)}
  .header-inner{width:min(1180px,100%);min-height:var(--site-header-height);margin:0 auto;padding:10px clamp(18px,4vw,56px);display:grid;grid-template-columns:minmax(0,1fr) auto auto;align-items:center;gap:24px;position:relative}
  .header-inner::after{content:'';position:absolute;bottom:0;left:clamp(18px,4vw,56px);right:clamp(18px,4vw,56px);height:1px;background:var(--line)}
  .brand{display:inline-flex;align-items:center;min-height:44px;justify-self:start;color:var(--ink);font:700 16px/1.2 var(--font-body);letter-spacing:.01em;text-decoration:none}
  .brand:hover{color:var(--blue)}
  .site-links{display:flex;align-items:center;justify-content:center;gap:clamp(14px,3vw,28px)}
  .site-links a{display:inline-flex;align-items:center;min-height:44px;color:var(--blue);font:700 18px/1.2 var(--font-body);text-decoration:none;white-space:nowrap}
  .site-links a:hover,.site-links a[aria-current='page']{text-decoration:underline;text-underline-offset:4px}
  .site-links a[aria-current='page']{text-decoration-color:var(--accent-strong);text-decoration-thickness:2px}
  .language-switcher{position:relative;display:grid;grid-template-columns:repeat(2,minmax(0,1fr));width:104px;padding:3px;border:1px solid var(--line);border-radius:999px;justify-self:end;background:var(--surface);font:700 14px/1.2 var(--font-body);letter-spacing:.08em;isolation:isolate}
  .language-indicator{position:absolute;z-index:-1;top:4px;bottom:4px;left:4px;width:calc((100% - 8px)/2);border-radius:999px;background:var(--accent);pointer-events:none}
  .language-switcher[data-locale='id'] .language-indicator{transform:translateX(100%)}
  .language-option{display:inline-flex;align-items:center;justify-content:center;min-height:44px;border-radius:999px;text-decoration:none;color:var(--blue)}
  .language-option[aria-current='page']{color:var(--ink)}
  a.language-option:hover{background:var(--surface-raised)}
  a.language-option:focus-visible{outline:2px solid var(--blue);outline-offset:3px}
  @media(prefers-reduced-motion:no-preference){a.language-option{transition:background-color .18s ease}}
  @media(max-width:760px){.header-inner{grid-template-columns:minmax(0,1fr) auto;gap:0 12px}.site-links{grid-column:1 / -1;grid-row:2}.language-switcher{grid-column:2;grid-row:1}}
  @media(max-width:380px){.site-links{gap:12px}.site-links a{font-size:16px}}
</style>
