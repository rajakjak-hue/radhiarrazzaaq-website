---
interface Props {
  locale: 'en' | 'id';
  alternateUrl: string;
  language: {
    navLabel: string;
    english: string;
    indonesian: string;
  };
}

const { locale, alternateUrl, language } = Astro.props;
const homeUrl = locale === 'en' ? '/' : '/id/';
const isBlogIndex = locale === 'en' && Astro.url.pathname.replace(/\/+$/, '') === '/blog';
---

<header class:list={['interior-header', { 'english-header': locale === 'en' }]}>
  <a class:list={['brand', { 'english-brand': locale === 'en' }]} href={homeUrl} aria-label={`Radhi Arrazzaaq, ${locale === 'en' ? 'home' : 'beranda'}`}>
    {locale === 'en' ? 'Radhi.' : <><span aria-hidden="true">R/A</span><span>Radhi Arrazzaaq</span></>}
  </a>
  {locale === 'en' && <nav class='site-links' aria-label='Explore'>
    <a href='/work/'>Case Studies</a>
    <a href='/blog/' aria-current={isBlogIndex ? 'page' : undefined}>Blog</a>
    <a href='/#enquiry-open'>Contact</a>
  </nav>}
  <nav class="language-switcher" aria-label={language.navLabel}>
    {locale === 'en' ? (
      <>
        <span aria-current="page">EN</span>
        <a href={alternateUrl} lang="id" hreflang="id" aria-label={language.indonesian}>ID</a>
      </>
    ) : (
      <>
        <a href={alternateUrl} lang="en" hreflang="en" aria-label={language.english}>EN</a>
        <span aria-current="page">ID</span>
      </>
    )}
  </nav>
</header>

<style>
  .interior-header{width:min(1180px,calc(100% - 48px));margin:0 auto;min-height:92px;display:flex;align-items:center;justify-content:space-between;border-bottom:1px solid var(--line)}
  .brand{display:inline-flex;align-items:center;gap:14px;text-decoration:none;font-family:var(--font-body);font-size:.83rem;font-weight:600;letter-spacing:.08em;text-transform:uppercase}
  .brand span:first-child{display:grid;place-items:center;width:38px;height:38px;border:1px solid var(--ink);color:var(--ink);font-size:.68rem;letter-spacing:.03em}
  .english-brand{font-size:16px;font-weight:700;letter-spacing:.01em;text-transform:none}
  .english-brand:hover{color:var(--blue)}
  .language-switcher{display:flex;align-items:center;gap:14px;font-family:var(--font-body);font-size:.74rem;font-weight:700;letter-spacing:.12em}
  .language-switcher a,.language-switcher span{padding:8px 0;text-decoration:none;border-bottom:1px solid transparent}
  .language-switcher span{color:var(--ink);border-color:var(--accent-strong)}
  .language-switcher a{color:var(--muted)}
  .language-switcher a:hover{color:var(--blue);border-color:var(--blue)}
  .english-header{display:grid;grid-template-columns:minmax(0,1fr) auto auto;gap:24px}
  .english-header .language-switcher{font-size:14px}
  .site-links{display:flex;align-items:center;gap:clamp(14px,3vw,28px)}
  .site-links a{display:inline-flex;align-items:center;min-height:44px;color:var(--blue);font:700 18px/1.2 var(--font-body);text-decoration:none;white-space:nowrap}
  .site-links a:hover,.site-links a[aria-current='page']{text-decoration:underline;text-underline-offset:4px}
  .site-links a[aria-current='page']{text-decoration-color:var(--accent);text-decoration-thickness:2px}
  @media (max-width:760px){.english-header{grid-template-columns:minmax(0,1fr) auto;gap:0 12px}.english-header .site-links{grid-column:1 / -1;grid-row:2;justify-content:center;padding-bottom:8px}.english-header .language-switcher{grid-column:2;grid-row:1}}
  @media (max-width:600px){.interior-header{width:min(100% - 28px,1180px);min-height:72px}.brand span:last-child{display:none}}
  @media (max-width:380px){.english-header .site-links{gap:12px}.english-header .site-links a{font-size:16px}}
</style>
